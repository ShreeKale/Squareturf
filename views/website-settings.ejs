<%- include('partials/head', { title }) %>

<%
  const labelCls = 'block text-sm font-medium text-neutral-700';
  const inputCls = 'mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3.5 py-2.5 text-sm text-neutral-900 outline-none placeholder:text-neutral-400 focus:border-blue-600 focus:ring-4 focus:ring-blue-100';
  const card = 'rounded-2xl bg-white p-5 shadow-sm ring-1 ring-neutral-200 sm:p-6';

  const defaultServices = [
    { name: 'Parking', description: 'Convenient parking available.' },
    { name: 'Washroom', description: 'Clean washroom facility.' },
    { name: 'Drinking Water', description: 'Drinking water available.' },
    { name: 'Floodlights', description: 'Evening and night play supported.' }
  ];
  const servicesJson = (typeof values !== 'undefined' && values && values.services !== undefined)
    ? values.services
    : JSON.stringify((tenant.services && tenant.services.length) ? tenant.services : defaultServices, null, 2);
  const imagesText = (typeof values !== 'undefined' && values && values.images !== undefined)
    ? values.images
    : (tenant.images || []).join('\n');
%>

<div class="mx-auto max-w-4xl">
  <div class="mb-6">
    <a href="/dashboard" class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-600 hover:text-neutral-900">
      <i data-lucide="arrow-left" class="h-4 w-4"></i>Dashboard
    </a>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-neutral-900">Website settings</h1>
    <p class="mt-1 text-neutral-600">Configure your public turf website, gallery and facilities.</p>
  </div>

  <% if (error) { %>
    <div role="alert" class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= error %></div>
  <% } %>
  <% if (flash) { %>
    <div role="status" class="mb-5 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700"><%= flash %></div>
  <% } %>

  <form method="post" action="/dashboard/website" class="space-y-6">

    <section class="<%= card %>">
      <h2 class="text-lg font-bold text-neutral-900">Business information</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <label class="<%= labelCls %>">Turf name
          <input name="name" value="<%= tenant.name %>" required maxlength="120" class="<%= inputCls %>">
        </label>
        <label class="<%= labelCls %>">Sport
          <input name="sport" value="<%= tenant.sport %>" maxlength="60" class="<%= inputCls %>">
        </label>
        <label class="<%= labelCls %> sm:col-span-2">Description
          <textarea name="description" rows="3" maxlength="1000" class="<%= inputCls %>"><%= tenant.description %></textarea>
        </label>
        <label class="<%= labelCls %> sm:col-span-2">Address
          <input name="address" value="<%= tenant.address %>" maxlength="300" class="<%= inputCls %>">
        </label>
        <label class="<%= labelCls %>">Phone
          <input name="phone" value="<%= tenant.phone %>" maxlength="20" class="<%= inputCls %>">
        </label>
        <label class="<%= labelCls %>">Email
          <input name="email" type="email" value="<%= tenant.email %>" class="<%= inputCls %>">
        </label>
      </div>
    </section>

    <section class="<%= card %>">
      <h2 class="text-lg font-bold text-neutral-900">Timing &amp; pricing</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <label class="<%= labelCls %>">Price per hour (₹)
          <input name="pricePerHour" type="number" min="0" value="<%= tenant.pricePerHour %>" class="<%= inputCls %>">
        </label>
        <label class="<%= labelCls %>">Opening time
          <input name="openingTime" type="time" value="<%= tenant.openingTime %>" class="<%= inputCls %>">
        </label>
        <label class="<%= labelCls %>">Closing time
          <input name="closingTime" type="time" value="<%= tenant.closingTime %>" class="<%= inputCls %>">
        </label>
      </div>
      <p class="mt-3 text-xs text-neutral-500">Closing time must be later than opening time. Slots are one hour each.</p>
    </section>

    <section class="<%= card %>">
      <h2 class="text-lg font-bold text-neutral-900">Links &amp; policy</h2>
      <p class="mt-1 text-sm text-neutral-500">These show in the footer of your website. Leave a box empty to hide that link.</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <label class="<%= labelCls %>">WhatsApp number
          <input name="whatsapp" type="tel" inputmode="numeric" value="<%= tenant.whatsapp || '' %>" placeholder="98765 43210" class="<%= inputCls %>">
          <span class="mt-1 block text-xs font-normal text-neutral-500">If empty, your contact phone is used.</span>
        </label>
        <label class="<%= labelCls %>">Instagram
          <input name="instagram" value="<%= tenant.instagram || '' %>" placeholder="@royalturf or the profile link" class="<%= inputCls %>">
        </label>
        <label class="<%= labelCls %> sm:col-span-2">Google Maps link
          <input name="mapUrl" value="<%= tenant.mapUrl || '' %>" placeholder="https://maps.app.goo.gl/..." class="<%= inputCls %>">
          <span class="mt-1 block text-xs font-normal text-neutral-500">In Google Maps, open your turf, tap Share and copy the link. If empty, your address is used.</span>
        </label>
        <label class="<%= labelCls %> sm:col-span-2">Cancellation and refund policy
          <textarea name="refundPolicy" rows="6" maxlength="1500" placeholder="One rule per line. If empty, a standard policy is shown." class="<%= inputCls %>"><%= tenant.refundPolicy || '' %></textarea>
        </label>
      </div>
    </section>

    <section class="<%= card %>">
      <h2 class="text-lg font-bold text-neutral-900">Photos</h2>
      <p class="mt-1 text-sm text-neutral-500">One image URL per line, up to 10. The first image is shown first in the banner. Image upload comes in a later step.</p>
      <textarea name="images" rows="6" placeholder="https://..." class="<%= inputCls %>"><%= imagesText %></textarea>
      <label class="<%= labelCls %> mt-4">Logo URL <span class="font-normal text-neutral-400">(optional)</span>
        <input name="logoUrl" value="<%= tenant.logoUrl %>" class="<%= inputCls %>">
      </label>
    </section>

    <section class="<%= card %>">
      <h2 class="text-lg font-bold text-neutral-900">Facilities &amp; services</h2>
      <p class="mt-1 text-sm text-neutral-500">Edit the list below. Each item needs a name, and can have a description. A simple form for this comes later.</p>
      <textarea name="services" rows="10" class="<%= inputCls %> font-mono"><%= servicesJson %></textarea>
    </section>

    <button class="w-full rounded-lg bg-neutral-900 px-5 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700">Save website settings</button>
  </form>
</div>

<%- include('partials/foot') %>