<%- include('partials/head', { title }) %>

<%
  const statuses = ['trial', 'active', 'past_due', 'cancelled', 'suspended'];
  const selectCls = 'w-full rounded-lg border border-neutral-300 bg-white px-3 py-2.5 text-sm capitalize text-neutral-900 outline-none focus:border-blue-600 focus:ring-4 focus:ring-blue-100 md:w-auto md:py-1.5';
  const setBtn = 'rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700 md:py-1.5';
%>

<h1 class="mb-5 text-2xl font-extrabold tracking-tight text-neutral-900 sm:mb-6 sm:text-3xl">SquareTurf administration</h1>

<div class="mb-6 grid grid-cols-3 gap-3 sm:mb-8 sm:gap-4">
  <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-neutral-200 sm:p-5">
    <p class="text-xs text-neutral-500 sm:text-sm">Owners</p>
    <p class="mt-1 text-2xl font-extrabold sm:text-3xl"><%= owners %></p>
  </div>
  <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-neutral-200 sm:p-5">
    <p class="text-xs text-neutral-500 sm:text-sm">Turf websites</p>
    <p class="mt-1 text-2xl font-extrabold sm:text-3xl"><%= tenants.length %></p>
  </div>
  <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-neutral-200 sm:p-5">
    <p class="text-xs text-neutral-500 sm:text-sm">Bookings</p>
    <p class="mt-1 text-2xl font-extrabold sm:text-3xl"><%= bookings %></p>
  </div>
</div>

<section class="rounded-2xl bg-white shadow-sm ring-1 ring-neutral-200">
  <div class="border-b border-neutral-200 px-4 py-4 sm:px-5">
    <h2 class="text-lg font-bold sm:text-xl">Tenants</h2>
  </div>

  <% if (!tenants.length) { %>
    <p class="px-5 py-12 text-center text-sm text-neutral-500">No turf websites yet.</p>
  <% } else { %>

    <!-- Phone: one card per turf -->
    <ul class="divide-y divide-neutral-200 md:hidden">
      <% tenants.forEach(t => { %>
        <li class="px-4 py-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="truncate font-semibold text-neutral-900"><%= t.name %></p>
              <p class="truncate text-sm text-neutral-500"><%= t.owner ? t.owner.email : '—' %></p>
            </div>
            <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset <%= t.isPublished ? 'bg-green-50 text-green-700 ring-green-600/20' : 'bg-neutral-100 text-neutral-600 ring-neutral-500/20' %>"><%= t.isPublished ? 'Published' : 'Hidden' %></span>
          </div>

          <p class="mt-2 text-sm text-neutral-600">
            <span class="font-medium text-neutral-800"><%= t.slug %></span>
            &middot; <span class="capitalize"><%= t.plan %></span>
            &middot; <span class="capitalize"><%= String(t.subscriptionStatus).replace('_', ' ') %></span>
          </p>

          <form method="post" action="/admin/tenants/<%= t._id %>/status" class="mt-3 grid gap-2">
            <select name="subscriptionStatus" aria-label="Subscription status for <%= t.name %>" class="<%= selectCls %>">
              <% statuses.forEach(s => { %>
                <option value="<%= s %>" <%= t.subscriptionStatus === s ? 'selected' : '' %>><%= s.replace('_', ' ') %></option>
              <% }) %>
            </select>
            <select name="isPublished" aria-label="Visibility for <%= t.name %>" class="<%= selectCls %>">
              <option value="true"  <%= t.isPublished ? 'selected' : '' %>>Published</option>
              <option value="false" <%= !t.isPublished ? 'selected' : '' %>>Hidden</option>
            </select>
            <button class="<%= setBtn %>">Save</button>
          </form>
        </li>
      <% }) %>
    </ul>

    <!-- Tablet and computer: table -->
    <div class="hidden overflow-x-auto md:block">
      <table class="w-full min-w-[760px] text-left text-sm">
        <thead class="bg-neutral-50 text-xs font-semibold text-neutral-500">
          <tr>
            <th scope="col" class="px-5 py-3">Turf</th>
            <th scope="col" class="px-3 py-3">Owner</th>
            <th scope="col" class="px-3 py-3">Subdomain</th>
            <th scope="col" class="px-3 py-3">Plan</th>
            <th scope="col" class="px-3 py-3">Status</th>
            <th scope="col" class="px-3 py-3">Published</th>
            <th scope="col" class="px-3 py-3 pr-5">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-200">
          <% tenants.forEach(t => { %>
            <tr class="hover:bg-neutral-50">
              <td class="px-5 py-3 font-medium text-neutral-900"><%= t.name %></td>
              <td class="px-3 py-3 text-neutral-600"><%= t.owner ? t.owner.email : '—' %></td>
              <td class="px-3 py-3 text-neutral-600"><%= t.slug %></td>
              <td class="px-3 py-3 capitalize text-neutral-600"><%= t.plan %></td>
              <td class="px-3 py-3 capitalize text-neutral-600"><%= String(t.subscriptionStatus).replace('_', ' ') %></td>
              <td class="px-3 py-3 text-neutral-600"><%= t.isPublished ? 'Yes' : 'No' %></td>
              <td class="px-3 py-3 pr-5">
                <form method="post" action="/admin/tenants/<%= t._id %>/status" class="flex items-center gap-1.5">
                  <select name="subscriptionStatus" aria-label="Subscription status for <%= t.name %>" class="<%= selectCls %>">
                    <% statuses.forEach(s => { %>
                      <option value="<%= s %>" <%= t.subscriptionStatus === s ? 'selected' : '' %>><%= s.replace('_', ' ') %></option>
                    <% }) %>
                  </select>
                  <select name="isPublished" aria-label="Visibility for <%= t.name %>" class="<%= selectCls %>">
                    <option value="true"  <%= t.isPublished ? 'selected' : '' %>>Published</option>
                    <option value="false" <%= !t.isPublished ? 'selected' : '' %>>Hidden</option>
                  </select>
                  <button class="<%= setBtn %>">Set</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('partials/foot') %>