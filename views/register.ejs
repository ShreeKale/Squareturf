<%- include('partials/head', { title }) %>

<%
  const labelCls = 'block text-sm font-medium text-neutral-800';
  const inputCls = 'mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3.5 py-3 text-sm text-neutral-900 outline-none placeholder:text-neutral-400 focus:border-blue-600 focus:ring-4 focus:ring-blue-100';
  const hintCls  = 'mt-1.5 block text-xs font-normal text-neutral-500';

  /* If your route passes the submitted values back as `values`, the form keeps them after an error */
  const v = (typeof values !== 'undefined' && values) ? values : {};
  const sports = ['Cricket', 'Box Cricket', 'Football', 'Futsal', 'Badminton', 'Other'];

  const included = [
    'Ready-made mobile website',
    'Your own SquareTurf web address',
    '1 ground / pitch',
    '10 gallery photos',
    'Manual bookings and a basic dashboard',
    'Email support'
  ];
%>

<div class="mx-auto max-w-5xl py-4 sm:py-8">

  <!-- Heading -->
  <div class="max-w-2xl">
    <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl">Create your turf website</h1>
    <p class="mt-3 text-neutral-600">It takes about two minutes. You can add photos, prices and timings after you sign up.</p>
    <p class="mt-3 inline-flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-sm text-neutral-700 ring-1 ring-neutral-200 lg:hidden">
      <i data-lucide="badge-check" class="h-4 w-4 text-blue-600"></i>
      Basic plan &middot; ₹499 / month &middot; 7-day trial
    </p>
  </div>

  <div class="mt-8 grid items-start gap-6 lg:grid-cols-[1fr_340px]">

    <!-- Form -->
    <div class="rounded-2xl bg-white shadow-sm ring-1 ring-neutral-200">

      <% if (error) { %>
        <div role="alert" class="m-5 mb-0 flex items-start gap-2.5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 sm:m-6 sm:mb-0">
          <i data-lucide="circle-alert" class="mt-0.5 h-4 w-4 shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form id="registerForm" method="post" action="/register" class="divide-y divide-neutral-200">

        <!-- Your details -->
        <fieldset class="grid gap-x-4 gap-y-5 p-5 sm:grid-cols-2 sm:p-6">
          <legend class="sr-only">Your details</legend>
          <div class="sm:col-span-2">
            <h2 class="text-lg font-bold text-neutral-900">Your details</h2>
            <p class="mt-0.5 text-sm text-neutral-500">You will use your email and password to log in.</p>
          </div>

          <label class="<%= labelCls %>">Owner name
            <input name="name" required maxlength="100" autocomplete="name" placeholder="Full name"
                   value="<%= v.name || '' %>" class="<%= inputCls %>">
          </label>

          <label class="<%= labelCls %>">Email
            <input type="email" name="email" required autocomplete="email" placeholder="you@example.com"
                   value="<%= v.email || '' %>" class="<%= inputCls %>">
          </label>

          <label class="<%= labelCls %>">Phone <span class="font-normal text-neutral-400">(optional)</span>
            <input type="tel" name="phone" autocomplete="tel" placeholder="98765 43210"
                   value="<%= v.phone || '' %>" class="<%= inputCls %>">
          </label>

          <div>
            <label for="password" class="<%= labelCls %>">Password</label>
            <div class="relative">
              <input id="password" type="password" name="password" required minlength="8"
                     autocomplete="new-password" placeholder="At least 8 characters" class="<%= inputCls %> pr-16">
              <button type="button" id="togglePassword" aria-controls="password" aria-pressed="false"
                      class="absolute inset-y-0 right-0 mt-1.5 flex items-center rounded-r-lg px-4 text-sm font-medium text-neutral-500 hover:text-neutral-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600">
                Show
              </button>
            </div>
          </div>
        </fieldset>

        <!-- Your turf -->
        <fieldset class="grid gap-x-4 gap-y-5 p-5 sm:grid-cols-2 sm:p-6">
          <legend class="sr-only">Your turf</legend>
          <div class="sm:col-span-2">
            <h2 class="text-lg font-bold text-neutral-900">Your turf</h2>
            <p class="mt-0.5 text-sm text-neutral-500">This is what customers will see on your website.</p>
          </div>

          <label class="<%= labelCls %>">Turf or business name
            <input id="turfName" name="turfName" required maxlength="120" placeholder="Royal Turf"
                   value="<%= v.turfName || '' %>" class="<%= inputCls %>">
          </label>

          <label class="<%= labelCls %>">Turf type
            <select name="sport" class="<%= inputCls %>">
              <% sports.forEach(s => { %>
                <option <%= v.sport === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </label>

          <div class="sm:col-span-2">
            <label for="slug" class="<%= labelCls %>">Website address</label>
            <div class="mt-1.5 flex items-stretch overflow-hidden rounded-lg border border-neutral-300 bg-white focus-within:border-blue-600 focus-within:ring-4 focus-within:ring-blue-100">
              <input id="slug" name="slug" required pattern="[A-Za-z0-9\-]{3,40}" minlength="3" maxlength="40"
                     placeholder="royalturf" autocapitalize="off" autocorrect="off" spellcheck="false"
                     value="<%= v.slug || '' %>"
                     class="min-w-0 flex-1 border-0 bg-transparent px-3.5 py-3 text-sm text-neutral-900 outline-none placeholder:text-neutral-400">
              <span class="flex items-center bg-neutral-50 px-3.5 text-sm text-neutral-500">.squareturf.com</span>
            </div>
            <p class="<%= hintCls %>">
              Your website will be at
              <strong class="font-semibold text-neutral-800"><span id="slugPreview"><%= v.slug || 'yourturf' %></span>.squareturf.com</strong>.
              Use 3 to 40 letters, numbers or hyphens.
            </p>
          </div>

          <label class="<%= labelCls %> sm:col-span-2">Business address <span class="font-normal text-neutral-400">(optional)</span>
            <input name="address" maxlength="300" autocomplete="street-address" placeholder="Street, area, city"
                   value="<%= v.address || '' %>" class="<%= inputCls %>">
          </label>
        </fieldset>

        <!-- Submit -->
        <div class="p-5 sm:p-6">
          <button id="submitBtn" type="submit"
                  class="w-full rounded-lg bg-neutral-900 px-5 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:cursor-not-allowed disabled:bg-neutral-400">
            Create account
          </button>
          <p class="mt-3 text-center text-xs text-neutral-500">Basic plan &middot; ₹499 / month &middot; includes a 7-day trial</p>
        </div>
      </form>
    </div>

    <!-- Plan summary -->
    <aside class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-neutral-200 lg:sticky lg:top-24">
      <p class="text-sm font-medium text-neutral-500">Your plan</p>
      <h2 class="mt-1 text-xl font-bold text-neutral-900">Basic</h2>
      <p class="mt-3 flex items-baseline gap-1">
        <span class="text-4xl font-extrabold tracking-tight text-neutral-900">₹499</span>
        <span class="text-sm text-neutral-500">/ month</span>
      </p>
      <p class="mt-1 text-sm text-neutral-600">Includes a 7-day trial.</p>

      <ul class="mt-5 space-y-3 border-t border-neutral-200 pt-5">
        <% included.forEach(item => { %>
          <li class="flex items-start gap-3 text-sm text-neutral-700">
            <i data-lucide="check" class="mt-0.5 h-4 w-4 shrink-0 text-blue-600"></i>
            <span><%= item %></span>
          </li>
        <% }) %>
      </ul>

      <p class="mt-5 border-t border-neutral-200 pt-5 text-sm text-neutral-600">
        Need online payments, multiple grounds or staff accounts?
        <a href="/pricing" class="font-semibold text-blue-600 hover:underline">Compare plans</a>
      </p>
    </aside>
  </div>

  <p class="mt-8 text-center text-sm text-neutral-600">
    Already registered?
    <a href="/login" class="font-semibold text-blue-600 hover:underline">Log in</a>
  </p>
</div>

<script>
  (() => {
    'use strict';

    const $ = (id) => document.getElementById(id);
    const password = $('password'), toggle = $('togglePassword');
    const turfName = $('turfName'), slug = $('slug'), preview = $('slugPreview');
    const form = $('registerForm'), submit = $('submitBtn');

    /* Show / hide password */
    toggle.addEventListener('click', () => {
      const show = password.type === 'password';
      password.type = show ? 'text' : 'password';
      toggle.textContent = show ? 'Hide' : 'Show';
      toggle.setAttribute('aria-pressed', String(show));
    });

    /* Website address: lowercase, no spaces or symbols, live preview */
    const clean = (value) => value.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '').slice(0, 40);
    const showPreview = () => { preview.textContent = slug.value || 'yourturf'; };

    let slugEdited = slug.value.trim() !== '';

    slug.addEventListener('input', () => {
      slugEdited = true;
      slug.value = clean(slug.value);
      showPreview();
    });

    /* Suggest an address from the turf name until the owner edits it themselves */
    turfName.addEventListener('input', () => {
      if (slugEdited) return;
      slug.value = clean(turfName.value).replace(/-+/g, '-').replace(/^-|-$/g, '');
      showPreview();
    });

    /* Friendly message when the address is too short or has invalid characters */
    slug.addEventListener('invalid', () => {
      slug.setCustomValidity('Use 3 to 40 letters, numbers or hyphens.');
    });
    slug.addEventListener('input', () => slug.setCustomValidity(''));

    /* Stop double submits */
    form.addEventListener('submit', () => {
      if (!form.checkValidity()) return;
      submit.disabled = true;
      submit.textContent = 'Creating your account…';
    });
  })();
</script>

<%- include('partials/foot') %>