<%- include('partials/head', { title }) %>

<%
  const labelCls = 'block text-sm font-medium text-neutral-800';
  const inputCls = 'mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3.5 py-3 text-sm text-neutral-900 outline-none placeholder:text-neutral-400 focus:border-blue-600 focus:ring-4 focus:ring-blue-100';

  /* If the route passes the submitted values back as `values`, the form keeps them after an error */
  const v = (typeof values !== 'undefined' && values) ? values : {};

  const steps = [
    { number: 1, label: 'Account' }, { number: 2, label: 'Business' }, { number: 3, label: 'Grounds' },
    { number: 4, label: 'Website' }, { number: 5, label: 'Plan' }, { number: 6, label: 'Publish' }
  ];

  const roadmap = [
    ['Create your account', 'Name, email and password. We email you a code to confirm it.'],
    ['Tell us about your turf', 'Name, sport, address and your website address.'],
    ['Set up your grounds', 'Price per hour, opening hours and the days you are open.'],
    ['Build your website', 'Logo, photos, a short description and a colour theme.'],
    ['Pick a plan', 'Basic, Standard or Premium. Your free trial starts when you publish.'],
    ['Preview and publish', 'See your website, then make it live.']
  ];
%>

<div class="mx-auto max-w-5xl py-4 sm:py-8">

  <div class="max-w-2xl">
    <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl">Create your turf website</h1>
    <p class="mt-3 text-neutral-600">Six short steps. Your progress is saved, so you can finish later.</p>
  </div>

  <div class="mt-8">
    <%- include('partials/stepper', { steps, step: 1 }) %>
  </div>

  <div class="grid items-start gap-6 lg:grid-cols-[1fr_340px]">

    <!-- Step 1: account -->
    <div class="rounded-2xl bg-white shadow-sm ring-1 ring-neutral-200">

      <% if (error) { %>
        <div role="alert" class="m-5 mb-0 flex items-start gap-2.5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 sm:m-6 sm:mb-0">
          <i data-lucide="circle-alert" class="mt-0.5 h-4 w-4 shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form id="registerForm" method="post" action="/register" class="p-5 sm:p-6">
        <h2 class="text-lg font-bold text-neutral-900">Create your account</h2>
        <p class="mt-0.5 text-sm text-neutral-500">You will use your email and password to log in.</p>

        <div class="mt-5 grid gap-x-4 gap-y-5 sm:grid-cols-2">
          <label class="<%= labelCls %>">Owner name
            <input name="name" required maxlength="100" autocomplete="name" placeholder="Full name"
                   value="<%= v.name || '' %>" class="<%= inputCls %>">
          </label>

          <label class="<%= labelCls %>">Phone number
            <input type="tel" name="phone" required inputmode="numeric" autocomplete="tel" placeholder="98765 43210"
                   value="<%= v.phone || '' %>" class="<%= inputCls %>">
          </label>

          <label class="<%= labelCls %> sm:col-span-2">Email
            <input type="email" name="email" required autocomplete="email" placeholder="you@example.com"
                   value="<%= v.email || '' %>" class="<%= inputCls %>">
            <span class="mt-1.5 block text-xs font-normal text-neutral-500">We will send a 6-digit code to this address.</span>
          </label>

          <div class="sm:col-span-2">
            <label for="password" class="<%= labelCls %>">Password</label>
            <div class="relative">
              <input id="password" type="password" name="password" required minlength="8"
                     autocomplete="new-password" placeholder="At least 8 characters" class="<%= inputCls %> pr-16">
              <button type="button" id="togglePassword" aria-controls="password" aria-pressed="false"
                      class="absolute inset-y-0 right-0 mt-1.5 flex items-center rounded-r-lg px-4 text-sm font-medium text-neutral-500 hover:text-neutral-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600">
                Show
              </button>
            </div>
          </div>
        </div>

        <button id="submitBtn" type="submit"
                class="mt-6 w-full rounded-lg bg-neutral-900 px-5 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:cursor-not-allowed disabled:bg-neutral-400">
          Create account and verify email
        </button>
        <p class="mt-3 text-center text-xs text-neutral-500">No payment details needed. Your free trial starts when you publish.</p>
      </form>
    </div>

    <!-- What happens next -->
    <aside class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-neutral-200 lg:sticky lg:top-24">
      <h2 class="text-base font-bold text-neutral-900">What happens next</h2>
      <ol class="mt-4 space-y-4">
        <% roadmap.forEach(([title, text], i) => { %>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-neutral-100 text-xs font-bold text-neutral-700"><%= i + 1 %></span>
            <span class="text-sm">
              <span class="block font-semibold text-neutral-900"><%= title %></span>
              <span class="mt-0.5 block text-neutral-600"><%= text %></span>
            </span>
          </li>
        <% }) %>
      </ol>
    </aside>
  </div>

  <p class="mt-8 text-center text-sm text-neutral-600">
    Already registered?
    <a href="/login" class="font-semibold text-blue-600 hover:underline">Log in</a>
  </p>
</div>

<script>
  (() => {
    'use strict';

    const password = document.getElementById('password');
    const toggle = document.getElementById('togglePassword');
    const form = document.getElementById('registerForm');
    const submit = document.getElementById('submitBtn');

    toggle.addEventListener('click', () => {
      const show = password.type === 'password';
      password.type = show ? 'text' : 'password';
      toggle.textContent = show ? 'Hide' : 'Show';
      toggle.setAttribute('aria-pressed', String(show));
    });

    /* Stop double submits */
    form.addEventListener('submit', () => {
      submit.disabled = true;
      submit.textContent = 'Creating your account…';
    });
  })();
</script>

<%- include('partials/foot') %>