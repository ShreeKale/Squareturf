<%- include('partials/head', { title }) %>

<div class="mx-auto w-full max-w-xl py-8 sm:py-16">
  <div class="rounded-2xl bg-white p-8 text-center shadow-sm ring-1 ring-neutral-200 sm:p-12">
    <h1 class="text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl"><%= title %></h1>
    <p class="mt-3 text-neutral-600"><%= message %></p>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:justify-center">
      <a href="/" class="inline-flex items-center justify-center rounded-lg bg-neutral-900 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-neutral-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">Go home</a>
      <a href="javascript:history.back()" class="inline-flex items-center justify-center rounded-lg px-6 py-3 text-sm font-semibold text-neutral-700 ring-1 ring-inset ring-neutral-300 transition-colors hover:bg-neutral-50">Go back</a>
    </div>
  </div>
</div>

<%- include('partials/foot') %>