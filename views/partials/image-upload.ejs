<%
  /* Shared look (same as the sign-up and settings pages) */
  const labelCls = 'block text-sm font-medium text-neutral-800';
  const inputCls = 'mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3.5 py-3 text-sm text-neutral-900 outline-none placeholder:text-neutral-400 focus:border-blue-600 focus:ring-4 focus:ring-blue-100';
  const hintCls  = 'mt-1.5 block text-xs font-normal text-neutral-500';
  /* Pass: tenant (logoUrl, images, name), maxPhotos, maxImageMb . Fields: logo, photos (files), removeLogo, removePhotos. Put it inside a form with enctype=multipart/form-data. */
%>
    <!-- Logo -->
    <section class="p-5 sm:p-6">
      <h2 class="text-base font-bold text-neutral-900">Logo</h2>
      <p class="mt-0.5 text-sm text-neutral-500">Square images look best. JPG, PNG or WebP. Large images are shrunk automatically.</p>

      <div class="mt-4 flex items-center gap-4">
        <span id="logoBox" class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-neutral-100 text-2xl font-bold text-neutral-400 ring-1 ring-neutral-200">
          <% if (tenant.logoUrl) { %><img src="<%= tenant.logoUrl %>" alt="Current logo" class="h-full w-full object-cover"><% } else { %><%= tenant.name.charAt(0).toUpperCase() %><% } %>
        </span>
        <div class="min-w-0 space-y-2">
          <input id="logoInput" type="file" name="logo" accept="image/jpeg,image/png,image/webp"
                 class="block w-full text-sm text-neutral-600 file:mr-3 file:rounded-lg file:border-0 file:bg-neutral-900 file:px-4 file:py-2.5 file:text-sm file:font-semibold file:text-white hover:file:bg-neutral-700">
          <% if (tenant.logoUrl) { %>
            <label class="flex items-center gap-2 text-sm text-neutral-600"><input type="checkbox" name="removeLogo" value="1" class="h-4 w-4 rounded border-neutral-300">Remove current logo</label>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Photos -->
    <section class="p-5 sm:p-6">
      <h2 class="text-base font-bold text-neutral-900">Turf photos</h2>
      <p class="mt-0.5 text-sm text-neutral-500">Up to <%= maxPhotos %> photos for the banner slideshow. The first one is shown first. Large photos are shrunk automatically.</p>

      <% if (tenant.images.length) { %>
        <ul class="mt-4 grid grid-cols-3 gap-3 sm:grid-cols-4">
          <% tenant.images.forEach((url, i) => { %>
            <li>
              <label class="group block cursor-pointer">
                <span class="relative block aspect-[4/3] overflow-hidden rounded-lg bg-neutral-100 ring-1 ring-neutral-200">
                  <img src="<%= url %>" alt="Photo <%= i + 1 %>" loading="lazy" class="h-full w-full object-cover">
                </span>
                <span class="mt-1.5 flex items-center gap-1.5 text-xs text-neutral-600">
                  <input type="checkbox" name="removePhotos" value="<%= url %>" class="h-3.5 w-3.5 rounded border-neutral-300">Remove
                </span>
              </label>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <input id="photosInput" type="file" name="photos" multiple accept="image/jpeg,image/png,image/webp"
             class="mt-4 block w-full text-sm text-neutral-600 file:mr-3 file:rounded-lg file:border-0 file:bg-neutral-900 file:px-4 file:py-2.5 file:text-sm file:font-semibold file:text-white hover:file:bg-neutral-700">
      <ul id="photoPreview" class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-4"></ul>
      <p id="fileError" class="mt-2 hidden text-sm text-red-700" role="alert"></p>
    </section>

<script>
  (() => {
    'use strict';
    const $ = (id) => document.getElementById(id);
    /* Phone photos are often 5 to 10 MB. They are shrunk here before upload, because the live server
       accepts about 4.5 MB per request in total. */
    const fileError = $('fileError');
    const logoInput = $('logoInput'), photosInput = $('photosInput');
    const RAW_MAX = 25 * 1024 * 1024;     // largest original we will try to shrink
    const TOTAL_MAX = 4 * 1024 * 1024;    // all new images together
    let pending = 0;

    function note(text, isError) {
      fileError.textContent = text || '';
      fileError.classList.toggle('hidden', !text);
      fileError.classList.toggle('text-red-700', Boolean(isError));
      fileError.classList.toggle('text-neutral-500', !isError);
    }

    async function shrink(file, maxSide, keepPng) {
      if (!file.type.startsWith('image/') || !window.createImageBitmap) return file;
      try {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, maxSide / Math.max(bitmap.width, bitmap.height));
        const width = Math.round(bitmap.width * scale), height = Math.round(bitmap.height * scale);

        const canvas = document.createElement('canvas');
        canvas.width = width; canvas.height = height;
        canvas.getContext('2d').drawImage(bitmap, 0, 0, width, height);

        const type = keepPng && file.type === 'image/png' ? 'image/png' : 'image/jpeg';
        const blob = await new Promise((resolve) => canvas.toBlob(resolve, type, 0.82));
        if (!blob || (scale === 1 && blob.size >= file.size)) return file;

        const name = file.name.replace(/\.[^.]+$/, '') + (type === 'image/png' ? '.png' : '.jpg');
        return new File([blob], name, { type, lastModified: Date.now() });
      } catch (_) {
        return file; // could not shrink: send the original
      }
    }

    function setFiles(input, files) {
      const list = new DataTransfer();
      files.forEach((file) => list.items.add(file));
      input.files = list.files;
    }

    const newBytes = () =>
      [...(logoInput ? logoInput.files : []), ...(photosInput ? photosInput.files : [])].reduce((sum, file) => sum + file.size, 0);

    /* Shrinks the chosen files, puts them back in the input, and checks the total size */
    async function prepare(input, maxSide, keepPng) {
      const original = [...input.files];
      const huge = original.find((file) => file.size > RAW_MAX);

      if (huge) {
        input.value = '';
        note(`"${huge.name}" is too large. Choose an image under 25 MB.`, true);
        return [];
      }

      pending += 1;
      note('Preparing your images…', false);
      try {
        const shrunk = await Promise.all(original.map((file) => shrink(file, maxSide, keepPng)));
        setFiles(input, shrunk);
      } finally {
        pending -= 1;
      }

      if (newBytes() > TOTAL_MAX) {
        input.value = '';
        note('These images are still too large together. Choose fewer photos, or save them at a lower quality.', true);
        return [];
      }

      note('', false);
      return [...input.files];
    }

    if (logoInput) {
      logoInput.addEventListener('change', async () => {
        const files = await prepare(logoInput, 600, true);
        if (!files.length) return;

        const img = document.createElement('img');
        img.src = URL.createObjectURL(files[0]);
        img.alt = 'New logo';
        img.className = 'h-full w-full object-cover';
        $('logoBox').replaceChildren(img);
      });
    }

    if (photosInput) {
      photosInput.addEventListener('change', async () => {
        $('photoPreview').replaceChildren();
        const files = await prepare(photosInput, 1600, false);

        $('photoPreview').replaceChildren(...files.map((file) => {
          const li = document.createElement('li');
          const img = document.createElement('img');
          img.src = URL.createObjectURL(file);
          img.alt = file.name;
          img.className = 'aspect-[4/3] w-full rounded-lg object-cover ring-1 ring-neutral-200';
          li.append(img);
          return li;
        }));
      });
    }

    /* Do not send the form while images are still being shrunk */
    const imageForm = photosInput && photosInput.form;
    if (imageForm) {
      imageForm.addEventListener('submit', (event) => {
        if (pending > 0) { event.preventDefault(); event.stopImmediatePropagation(); }
      }, true);
    }

  })();
</script>