<%
  /* ---------- View data ---------- */
  const name       = tenant.name || 'Turf';
  const price      = Number(tenant.pricePerHour) || 0;
  const hasTiming  = tenant.openingTime && tenant.closingTime;
  const hasContact = !!(tenant.phone || tenant.email);
 
  /* Colour theme (replaces the blue shades) and preview mode (owner checking the site before it is live) */
  const accent    = (locals.theme && locals.theme.colors) || null;
  const isPreview = !!locals.preview;
 
  /* The logged-in customer of this turf website, or null */
  const currentCustomer = locals.customer || null;
  const customerJson    = JSON.stringify(currentCustomer).replace(/</g, '\\u003c');
  const firstName = (value) => String(value || '').trim().split(/\s+/)[0];
  const initialOf = (value) => String(value || '?').trim().charAt(0).toUpperCase();
 
  /* Small icons for the user card (24x24, stroke style) */
  const icons = {
    chevron:  '<path d="m6 9 6 6 6-6"/>',
    calendar: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
    plus:     '<circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/>',
    grid:     '<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>',
    phone:    '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
    logout:   '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>',
    pin:      '<path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
    close:    '<path d="M18 6 6 18M6 6l12 12"/>',
    clock:    '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
    trophy:   '<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>',
    rupee:    '<path d="M6 3h12"/><path d="M6 8h12"/><path d="m6 13 8.5 8"/><path d="M6 13h3"/><path d="M9 13c6.667 0 6.667-10 0-10"/>',
    chevronL: '<path d="m15 18-6-6 6-6"/>',
    chevronR: '<path d="m9 18 6-6-6-6"/>'
  };
  const icon = (key, cls = 'h-5 w-5') =>
    `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[key]}</svg>`;
 
  /* Hero slideshow: the venue's own photos if it has any, otherwise 5 real turf photos from the web.
     To use your own images instead, replace these URLs with e.g. '/images/turf/turf-1.jpg' */
  const venuePhotos   = Array.isArray(tenant.images) ? tenant.images.filter(Boolean) : [];
  const defaultPhotos = [
    'https://loremflickr.com/1400/800/football,pitch?lock=11',
    'https://loremflickr.com/1400/800/soccer,field?lock=12',
    'https://loremflickr.com/1400/800/football,stadium?lock=13',
    'https://loremflickr.com/1400/800/soccer,grass?lock=14',
    'https://loremflickr.com/1400/800/football,goal?lock=15'
  ];
  const photos = (venuePhotos.length ? venuePhotos : defaultPhotos).slice(0, 6);
 
  /* Facilities */
  const defaultServices = [
    { name: 'Parking',          description: 'Convenient parking available.' },
    { name: 'Floodlights',      description: 'Evening and night play supported.' },
    { name: 'Restroom',          description: 'Clean restroom facility.' },
    { name: 'Drinking water',   description: 'Drinking water available.' },
    { name: 'Changing room',    description: 'Change and keep your bags safe.' },
    { name: 'Equipment rental', description: 'Balls, bibs and cones on request.' },
    { name: 'First aid',        description: 'Basic first aid kit on site.' },
    { name: 'Seating area',     description: 'Sit and watch the game.' }
  ];
  const services = Array.isArray(tenant.services) && tenant.services.length
    ? tenant.services
    : defaultServices;
 
  /* Facility photo: service.image if the venue set one, otherwise matched by name */
  const facilityPhotos = [
    [/park/i,                       '/img/parking.jpg'],
    [/flood|light/i,                '/img/floodlights.jfif'],
    [/wash|toilet|rest ?room|bath/i,'/img/restroom.jpg'],
    [/water|drink/i,                '/img/water.jfif'],
    [/chang|locker|room/i,          '/img/changing%20room.jfif'],
    [/equip|rent|ball|gear/i,       '/img/equipments.jfif'],
    [/first|aid|medic/i,            '/img/first%20aid.jfif'],
    [/seat|bench|stand|lounge/i,    'https://loremflickr.com/640/480/stadium,seats?lock=28'],
    [/cafe|food|snack|canteen/i,    'https://loremflickr.com/640/480/cafe,snacks?lock=29'],
    [/wifi|wi-fi/i,                 'https://loremflickr.com/640/480/wifi,router?lock=30']
  ];
  const imageFor = (service) => {
    if (service.image) return service.image;
    const hit = facilityPhotos.find(([pattern]) => pattern.test(service.name || ''));
    return hit ? hit[1] : 'https://loremflickr.com/640/480/football,turf?lock=31';
  };
 
  /* Social + location links (shown only when the venue has the data) */
  const waDigits = String(tenant.whatsapp || tenant.phone || '').replace(/\D/g, '');
  const waNumber = waDigits.length === 10 ? '91' + waDigits : waDigits;
  const waUrl    = waNumber
    ? `https://wa.me/${waNumber}?text=${encodeURIComponent('Hi, I would like to book a slot at ' + name)}`
    : '';
  const igRaw    = String(tenant.instagram || '').trim();
  const igUrl    = igRaw
    ? (/^https:\/\/(www\.)?instagram\.com\//i.test(igRaw) ? igRaw : `https://www.instagram.com/${igRaw.replace(/^@/, '').replace(/[^A-Za-z0-9._]/g, '')}`)
    : '';
  const ownMapUrl = /^https?:\/\//i.test(String(tenant.mapUrl || '')) ? tenant.mapUrl : '';
  const mapUrl   = ownMapUrl ||
    (tenant.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(name + ' ' + tenant.address)}` : '');
  const mapEmbed = tenant.address
    ? `https://maps.google.com/maps?q=${encodeURIComponent(name + ' ' + tenant.address)}&z=15&output=embed`
    : '';
 
  /* Days the turf is open, as a short label: "Every day", "Mon – Fri", "Mon, Wed, Sat" */
  const dayOrder = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
  const dayShort = { mon: 'Mon', tue: 'Tue', wed: 'Wed', thu: 'Thu', fri: 'Fri', sat: 'Sat', sun: 'Sun' };
  const openKeys = dayOrder.filter((d) => (tenant.operatingDays || []).includes(d));
  const openIdx  = openKeys.map((d) => dayOrder.indexOf(d));
  const isRange  = openIdx.length > 2 && openIdx.every((n, i) => i === 0 || n === openIdx[i - 1] + 1);
  const daysLabel = !openKeys.length || openKeys.length === 7 ? 'Every day'
    : isRange ? `${dayShort[openKeys[0]]} – ${dayShort[openKeys[openKeys.length - 1]]}`
    : openKeys.map((d) => dayShort[d]).join(', ');
 
  /* Quick facts under the banner */
  const facts = [
    ['trophy', 'Sport', tenant.sport || 'Sports turf'],
    ['grid',   'Grounds', String(tenant.groundsCount || 1)],
    ['clock',  'Timing', hasTiming ? `${tenant.openingTime} – ${tenant.closingTime}` : 'Ask the turf'],
    ['calendar', 'Open', daysLabel]
  ];
 
  /* Questions most customers ask, answered from this turf's own details */
  const faqs = [
    ['How do I book a slot?', 'Pick a date, tap one or more hourly slots, then tap Next. Your request goes to the turf owner, who confirms it.'],
    ['What are the timings?', hasTiming ? `We are open ${daysLabel.toLowerCase()}, from ${tenant.openingTime} to ${tenant.closingTime}. Each slot is one hour.` : 'Each slot is one hour. Please contact the turf for the exact timings.'],
    ['How much does it cost?', `₹${price.toLocaleString('en-IN')} per hour. Book two hours back to back and you pay for two slots.`],
    ['Do I need an account to book?', 'No. You can book with just your name and phone number. An account saves your details and shows your booking history.'],
    ['Can I cancel or get a refund?', 'Yes. Tap Refund policy at the bottom of this page to read the rules. To cancel, call or message the turf.'],
    tenant.address ? ['Where is the turf?', tenant.address] : null,
    hasContact ? ['How can I contact the turf?', [tenant.phone ? `Call ${tenant.phone}` : '', waUrl ? 'message on WhatsApp' : '', tenant.email ? `or email ${tenant.email}` : ''].filter(Boolean).join(', ') + '.'] : null
  ].filter(Boolean);
 
  /* Refund policy: the owner's own text (one rule per line), or a standard one */
  const defaultRefund = [
    'Cancel 24 hours or more before your slot: full refund.',
    'Cancel between 6 and 24 hours before: 50% refund.',
    'Cancel less than 6 hours before, or not turning up: no refund.',
    'If the turf cancels your booking, you get a full refund or a free change of slot.',
    'To cancel or change a booking, call or message the turf with your name and booking date.'
  ];
  const ownRefund = String(tenant.refundPolicy || '').split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
  const refundLines = ownRefund.length ? ownRefund : defaultRefund;
 
  const now = new Date();
  const today = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, '0'),
    String(now.getDate()).padStart(2, '0')
  ].join('-');
%>
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= name %> | SquareTurf</title>
 
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet">
 
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Bricolage Grotesque"', 'ui-sans-serif', 'system-ui', 'sans-serif'] }<% if (accent) { %>,
          colors: { blue: <%- JSON.stringify(accent) %> }<% } %>
        }
      }
    };
  </script>
 
  <style type="text/tailwindcss">
    @layer components {
      /* Time slot button and its three states */
      .slot            { @apply min-h-[72px] rounded-xl border p-2.5 text-left transition-colors sm:min-h-[76px] sm:p-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600; }
      .slot-status     { @apply text-[10px] font-semibold uppercase tracking-wide sm:text-[11px]; }
      .slot-time       { @apply mt-1 text-[13px] font-bold leading-tight sm:text-sm; }
      .slot-end        { @apply mt-0.5 text-[11px] font-medium leading-tight opacity-75 sm:text-xs; }
 
      .slot--available { @apply border-neutral-300 bg-white hover:border-blue-600 hover:bg-blue-50; }
      .slot--available .slot-status { @apply text-blue-700; }
 
      .slot--selected  { @apply border-blue-600 bg-blue-600 text-white shadow-md; }
      .slot--selected .slot-status  { @apply text-blue-100; }
 
      .slot--booked    { @apply cursor-not-allowed border-neutral-200 bg-neutral-100 text-neutral-400; }
      .slot--booked .slot-status    { @apply text-neutral-400; }
 
      /* Form fields and buttons */
      .field    { @apply w-full rounded-lg border border-neutral-300 bg-white px-4 py-3 text-sm outline-none placeholder:text-neutral-400 focus:border-blue-600 focus:ring-4 focus:ring-blue-100; }
      .btn-dark { @apply w-full rounded-lg bg-neutral-900 px-4 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:cursor-not-allowed disabled:bg-neutral-200 disabled:text-neutral-500; }
 
      /* Log in / Register switch */
      .tab         { @apply flex-1 rounded-lg px-3 py-2 text-sm font-semibold text-neutral-600 transition-colors hover:text-neutral-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600; }
      .tab--active { @apply bg-white text-neutral-900 shadow-sm; }
 
      /* Rows inside the user card */
      .menu-item { @apply flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-medium text-neutral-700 transition-colors hover:bg-neutral-100 hover:text-neutral-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600; }
 
      /* Banner carousel */
      .dot         { @apply h-2 w-2 rounded-full bg-white/50 transition-all hover:bg-white/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white; }
      .dot--active { @apply w-6 bg-white; }
      .arrow       { @apply hidden h-10 w-10 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur transition-colors hover:bg-white/35 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white sm:flex; }
 
      /* Date strip (like a cinema booking page) */
      .day         { @apply flex min-w-[4.25rem] shrink-0 snap-start flex-col items-center rounded-xl border border-neutral-300 bg-white px-2 py-2.5 text-center transition-colors hover:border-blue-600 sm:min-w-[4.75rem] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600; }
      .day--active { @apply border-blue-600 bg-blue-600 text-white shadow-md hover:border-blue-600; }
      .day--off    { @apply cursor-not-allowed border-neutral-200 bg-neutral-100 text-neutral-400 hover:border-neutral-200; }
 
      /* Round social / location icon buttons in the footer */
      .social { @apply flex h-11 w-11 items-center justify-center rounded-full bg-neutral-100 text-neutral-700 transition-colors hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600; }
    }
  </style>
 
  <style>
    @keyframes spin { to { transform: rotate(360deg); } }
    :root { --accent: <%= accent ? accent[600] : '#2563eb' %>; --accent-soft: <%= accent ? accent[100] : '#dbeafe' %>; }
    .loader { width: 18px; height: 18px; border: 2px solid var(--accent-soft); border-top-color: var(--accent); border-radius: 50%; animation: spin .7s linear infinite; }
    @media (prefers-reduced-motion: reduce) { .loader { animation-duration: 2s; } }
 
    /* Green turf behind the photos: shows while photos load, or if none can be loaded */
    .turf-bg {
      background:
        radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,.25) 100%),
        repeating-linear-gradient(90deg, #2e8b4a 0 80px, #3aa25b 80px 160px);
    }
 
    /* Bottom bar with the Next button (plain CSS so it always works) */
    .selection-bar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
      background: #fff; border-top: 1px solid #e5e5e5;
      padding: 12px 20px calc(12px + env(safe-area-inset-bottom, 0px));
      box-shadow: 0 -4px 16px rgba(0,0,0,.08);
    }
    .selection-bar[hidden] { display: none; }
 
    /* Date strip scrolls sideways without a visible scrollbar */
    .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
  </style>
</head>
 
<body class="bg-neutral-100 font-sans text-neutral-900 antialiased selection:bg-blue-600 selection:text-white">
 
  <% if (isPreview) { %>
    <p class="bg-neutral-900 px-4 py-2 text-center text-xs font-medium text-white">Preview: your website is not live yet</p>
  <% } %>
 
  <!-- Navbar: on a phone it shows the logo, your name (or Log in) and Book now -->
  <header class="sticky top-0 z-40 border-b border-neutral-200 bg-white/90 backdrop-blur">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-2 px-4 sm:px-5 lg:px-8" aria-label="Main">
 
      <a href="#top" class="flex min-w-0 items-center gap-3">
        <% if (tenant.logoUrl) { %>
          <img src="<%= tenant.logoUrl %>" alt="" class="h-10 w-10 shrink-0 rounded-lg object-cover">
        <% } else { %>
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-600 font-bold text-white">
            <%= name.charAt(0).toUpperCase() %>
          </span>
        <% } %>
        <span class="hidden min-w-0 leading-tight min-[420px]:block">
          <span class="block max-w-[9rem] truncate font-bold sm:max-w-xs"><%= name %></span>
          <span class="hidden text-xs text-neutral-500 sm:block">Powered by SquareTurf</span>
        </span>
      </a>
 
      <div class="flex shrink-0 items-center gap-1 text-sm font-medium sm:gap-1.5">
        <a href="#facilities" class="hidden rounded-lg px-3 py-2 text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 md:block">Facilities</a>
        <% if (mapUrl) { %>
          <a href="#location" class="hidden rounded-lg px-3 py-2 text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 md:block">Location</a>
        <% } %>
        <% if (hasContact) { %>
          <a href="#contact" class="hidden rounded-lg px-3 py-2 text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 md:block">Contact</a>
        <% } %>
 
        <!-- Shown when nobody is logged in -->
        <button id="loginBtn" type="button" data-auth-open="login"
          class="rounded-lg px-3 py-2 font-semibold text-neutral-800 hover:bg-neutral-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 <%= currentCustomer ? 'hidden' : '' %>">
          Log in
        </button>
 
        <!-- Shown after login: the customer's name opens the user card -->
        <div id="userMenu" class="relative <%= currentCustomer ? '' : 'hidden' %>">
          <button id="userBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="userCard"
            class="flex items-center gap-1.5 rounded-full bg-neutral-100 py-1 pl-1 pr-2 font-semibold text-neutral-800 transition-colors hover:bg-neutral-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 sm:gap-2 sm:pr-3">
            <span id="userInitial" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-600 text-xs font-bold text-white"><%= currentCustomer ? initialOf(currentCustomer.name) : '' %></span>
            <span id="userFirstName" class="max-w-[4.5rem] truncate sm:hidden"><%= currentCustomer ? firstName(currentCustomer.name) : '' %></span>
            <span id="userFullName" class="hidden max-w-[10rem] truncate sm:inline"><%= currentCustomer ? currentCustomer.name : '' %></span>
            <%- icon('chevron', 'h-4 w-4 shrink-0 text-neutral-500') %>
          </button>
 
          <!-- User card -->
          <div id="userCard" role="menu" aria-label="Your account"
            class="fixed inset-x-3 top-[4.25rem] z-50 hidden rounded-2xl bg-white p-2 shadow-xl ring-1 ring-neutral-200 sm:absolute sm:inset-x-auto sm:right-0 sm:top-full sm:mt-2 sm:w-80">
 
            <div class="flex items-center gap-3 p-3">
              <span id="cardInitial" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blue-600 text-base font-bold text-white"></span>
              <div class="min-w-0">
                <p id="cardName" class="truncate font-bold text-neutral-900"></p>
                <p id="cardPhone" class="truncate text-sm text-neutral-600"></p>
                <p id="cardEmail" class="truncate text-xs text-neutral-500"></p>
              </div>
            </div>
 
            <div class="my-1 border-t border-neutral-200"></div>
 
            <ul class="py-1">
              <li>
                <button type="button" id="historyOpen" role="menuitem" class="menu-item">
                  <span class="text-neutral-500"><%- icon('calendar') %></span>
                  <span class="flex-1">My bookings<span class="block text-xs font-normal text-neutral-500">Booking history</span></span>
                </button>
              </li>
              <li>
                <a href="#booking" role="menuitem" data-menu-link class="menu-item">
                  <span class="text-neutral-500"><%- icon('plus') %></span>Book a slot
                </a>
              </li>
              <li>
                <a href="#facilities" role="menuitem" data-menu-link class="menu-item">
                  <span class="text-neutral-500"><%- icon('grid') %></span>Facilities
                </a>
              </li>
              <% if (mapUrl) { %>
                <li>
                  <a href="#location" role="menuitem" data-menu-link class="menu-item">
                    <span class="text-neutral-500"><%- icon('pin') %></span>Location
                  </a>
                </li>
              <% } %>
              <% if (hasContact) { %>
                <li>
                  <a href="#contact" role="menuitem" data-menu-link class="menu-item">
                    <span class="text-neutral-500"><%- icon('phone') %></span>Contact
                  </a>
                </li>
              <% } %>
            </ul>
 
            <div class="border-t border-neutral-200 pt-1">
              <button type="button" id="logoutBtn" role="menuitem" class="menu-item text-red-700 hover:bg-red-50 hover:text-red-800">
                <span><%- icon('logout') %></span>Log out
              </button>
            </div>
          </div>
        </div>
 
        <a href="#booking"
          class="rounded-lg bg-blue-600 px-3 py-2 font-semibold text-white transition-colors hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 sm:px-4">
          Book now
        </a>
      </div>
    </nav>
  </header>
 
  <main id="top">
 
    <!-- Hero: photo slideshow -->
    <section class="mx-auto max-w-6xl px-5 pt-6 lg:px-8 lg:pt-8">
      <div id="heroCarousel" class="relative isolate overflow-hidden rounded-3xl bg-neutral-800"
           role="region" aria-roledescription="carousel" aria-label="<%= name %> photos">
 
        <!-- Turf pattern (always behind the photos) -->
        <div class="turf-bg absolute inset-0 -z-20" aria-hidden="true"></div>
        <svg class="absolute inset-0 -z-20 h-full w-full" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice"
             fill="none" stroke="rgba(255,255,255,.5)" stroke-width="3" aria-hidden="true">
          <rect x="40" y="40" width="720" height="420"/>
          <line x1="400" y1="40" x2="400" y2="460"/>
          <circle cx="400" cy="250" r="62"/>
          <rect x="40" y="150" width="110" height="200"/>
          <rect x="650" y="150" width="110" height="200"/>
        </svg>
 
        <!-- Photos -->
        <div class="absolute inset-0 -z-10">
          <% photos.forEach((photo, i) => { %>
            <img data-slide
                 src="<%= photo %>"
                 alt="<%= name %> photo <%= i + 1 %>"
                 decoding="async"
                 aria-hidden="<%= i === 0 ? 'false' : 'true' %>"
                 class="absolute inset-0 h-full w-full object-cover transition-opacity duration-700 motion-reduce:transition-none <%= i === 0 ? 'opacity-100' : 'opacity-0' %>">
          <% }) %>
        </div>
 
        <!-- Shade so the text stays readable on any photo -->
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-neutral-950/85 via-neutral-950/35 to-neutral-950/10"></div>
 
        <!-- Slide dots (created by the script) -->
        <div data-dots class="absolute right-5 top-5 flex items-center gap-2" role="group" aria-label="Choose photo"></div>
 
        <!-- Prev / next -->
        <button type="button" data-prev aria-label="Previous photo" class="arrow absolute left-4 top-1/2 -translate-y-1/2">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" data-next aria-label="Next photo" class="arrow absolute right-4 top-1/2 -translate-y-1/2">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
 
        <div class="flex min-h-[224px] flex-col justify-end p-5 text-white sm:min-h-[320px] sm:p-8 lg:min-h-[380px]">
          <p class="text-sm font-medium text-blue-200"><%= tenant.sport || 'Sports turf' %></p>
          <h1 class="mt-2 max-w-2xl text-3xl font-extrabold tracking-tight sm:text-4xl"><%= name %></h1>
          <% if (tenant.address) { %>
            <p class="mt-2 flex max-w-xl items-start gap-1.5 text-sm text-neutral-200">
              <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
              <span><%= tenant.address %></span>
            </p>
          <% } %>
 
          <div class="mt-4 flex flex-wrap items-center gap-3 sm:mt-5">
            <span class="rounded-lg bg-white/15 px-3.5 py-2 text-sm font-semibold backdrop-blur">
              <span class="font-normal text-neutral-200">Starts from</span> ₹<%= price.toLocaleString('en-IN') %> <span class="font-normal text-neutral-200">/ hour</span>
            </span>
          </div>
        </div>
      </div>
    </section>
 
    <!-- Quick facts -->
    <section class="mx-auto max-w-6xl px-5 pt-6 lg:px-8" aria-label="Quick facts">
      <ul class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        <% facts.forEach(([key, label, value], i) => { %>
          <li class="flex items-center gap-3 rounded-2xl bg-white p-3.5 ring-1 ring-neutral-200 <%= i === facts.length - 1 && facts.length % 2 === 1 ? 'col-span-2 sm:col-span-1' : '' %>">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600"><%- icon(key, 'h-5 w-5') %></span>
            <span class="min-w-0">
              <span class="block text-xs text-neutral-500"><%= label %></span>
              <span class="block truncate text-sm font-semibold text-neutral-900" title="<%= value %>"><%= value %></span>
            </span>
          </li>
        <% }) %>
      </ul>
    </section>
 
    <!-- Booking: time slots directly below the banner -->
    <section id="booking" class="mx-auto max-w-6xl scroll-mt-20 px-5 pt-10 lg:px-8">
      <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Select your slots</h2>
      <p class="mt-2 text-neutral-600">Pick a day, then pick your hourly slots. You can select more than one.<% if (Array.isArray(tenant.operatingDays) && tenant.operatingDays.length && tenant.operatingDays.length < 7) { %> Open <%= tenant.operatingDays.map((d) => d.charAt(0).toUpperCase() + d.slice(1)).join(", ") %>.<% } %></p>
 
      <div class="mt-6 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-neutral-200 sm:p-7">
        <div class="flex items-baseline justify-between gap-3">
          <h3 id="dateHeading" class="text-sm font-semibold">Choose a date</h3>
          <p id="dateLabel" class="text-sm text-neutral-500" aria-live="polite"></p>
        </div>
 
        <!-- Next 21 days: today and the 20 days after. The chosen date is kept in the hidden field. -->
        <input id="bookingDate" type="hidden" value="<%= today %>">
        <div class="relative mt-3">
          <button type="button" id="dayPrev" aria-label="Earlier dates"
            class="absolute -left-3 top-1/2 z-10 hidden h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white text-neutral-700 shadow ring-1 ring-neutral-200 hover:bg-neutral-50 md:flex">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <div id="dateStrip" role="group" aria-labelledby="dateHeading"
               class="no-scrollbar flex snap-x gap-2 overflow-x-auto scroll-smooth py-1 md:px-1"></div>
          <button type="button" id="dayNext" aria-label="Later dates"
            class="absolute -right-3 top-1/2 z-10 hidden h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white text-neutral-700 shadow ring-1 ring-neutral-200 hover:bg-neutral-50 md:flex">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
 
        <ul class="mt-5 flex flex-wrap gap-5 text-sm text-neutral-600" aria-label="Legend">
          <li class="flex items-center gap-2"><span class="h-3 w-3 rounded-full border border-neutral-300 bg-white"></span>Available</li>
          <li class="flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-neutral-300"></span>Booked</li>
          <li class="flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-blue-600"></span>Selected</li>
        </ul>
 
        <div id="slotLoading" class="mt-7 hidden items-center gap-3 text-sm text-neutral-500" role="status">
          <span class="loader"></span>Checking availability…
        </div>
        <div id="slotError" class="mt-7 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"></div>
 
        <div id="slotGrid" class="mt-7 grid grid-cols-3 gap-2 sm:gap-3 md:grid-cols-4 lg:grid-cols-6"></div>
 
        <div id="slotEmpty" class="mt-7 hidden rounded-xl border border-dashed border-neutral-300 p-8 text-center">
          <p class="font-semibold">No slots available</p>
          <p class="mt-1 text-sm text-neutral-500">There are no bookable slots on this date. Try another day.</p>
        </div>
      </div>
    </section>
 
    <!-- How it works -->
    <section class="mx-auto max-w-6xl px-5 pt-14 lg:px-8">
      <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">How booking works</h2>
      <ol class="mt-6 grid gap-3 sm:grid-cols-3 sm:gap-4">
        <% [
          ['1', 'Pick your slots', 'Choose a date and one or more hourly slots.'],
          ['2', 'Send your request', 'Tap Next. Log in once and your details are filled in for you.'],
          ['3', 'Get confirmed', 'The turf owner confirms your booking.']
        ].forEach(([n, title, text]) => { %>
          <li class="flex items-start gap-4 rounded-2xl bg-white p-5 ring-1 ring-neutral-200">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-bold text-white"><%= n %></span>
            <span>
              <span class="block font-semibold"><%= title %></span>
              <span class="mt-1 block text-sm text-neutral-600"><%= text %></span>
            </span>
          </li>
        <% }) %>
      </ol>
    </section>
 
    <!-- Facilities -->
    <section id="facilities" class="mx-auto max-w-6xl scroll-mt-20 px-5 pt-14 lg:px-8">
      <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Facilities</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        <% services.forEach(service => { %>
          <article class="group relative isolate h-36 overflow-hidden rounded-2xl bg-neutral-800 sm:h-40">
            <img src="<%= imageFor(service) %>" alt="" loading="lazy" decoding="async"
                 onerror="this.remove()"
                 class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none">
            <!-- Dark fade so the text is always readable -->
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-neutral-950/95 via-neutral-950/55 to-neutral-950/10"></div>
 
            <div class="flex h-full flex-col justify-end p-3.5 text-white sm:p-4">
              <div>
                <h3 class="text-sm font-bold sm:text-base"><%= service.name %></h3>
                <% if (service.description) { %>
                  <p class="mt-1 line-clamp-2 text-xs leading-snug text-neutral-200 sm:text-sm"><%= service.description %></p>
                <% } %>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
 
    <!-- Gallery (only the venue's own photos) -->
    <% if (venuePhotos.length) { const shown = venuePhotos.slice(0, 5); const extra = venuePhotos.length - shown.length; %>
      <section id="gallery" class="mx-auto max-w-6xl scroll-mt-20 px-5 pt-14 lg:px-8">
        <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Gallery</h2>
        <div class="mt-6 grid grid-cols-2 gap-2 sm:gap-3 md:grid-cols-4 md:grid-rows-2">
          <% shown.forEach((photo, i) => { %>
            <button type="button" data-lightbox="<%= i %>" aria-label="Open photo <%= i + 1 %> of <%= venuePhotos.length %>"
              class="group relative overflow-hidden rounded-2xl bg-neutral-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 <%= i === 0 ? 'col-span-2 aspect-[4/3] md:row-span-2 md:aspect-auto' : 'aspect-[4/3]' %>">
              <img src="<%= photo %>" alt="<%= name %> photo <%= i + 1 %>" loading="lazy" decoding="async"
                   class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none">
              <% if (i === shown.length - 1 && extra > 0) { %>
                <span class="absolute inset-0 flex items-center justify-center bg-neutral-950/60 text-xl font-bold text-white">+<%= extra %> more</span>
              <% } %>
            </button>
          <% }) %>
        </div>
      </section>
    <% } %>
 
    <!-- Reviews -->
    <section id="reviews" class="mx-auto max-w-6xl scroll-mt-20 px-5 pt-14 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Reviews</h2>
        <button id="writeReview" type="button" class="hidden rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-neutral-700">Write a review</button>
      </div>
 
      <div class="mt-6 grid gap-4 lg:grid-cols-[18rem_1fr]">
        <div id="ratingSummary" class="rounded-2xl bg-white p-5 ring-1 ring-neutral-200 sm:p-6">
          <p class="text-sm text-neutral-500">Loading reviews…</p>
        </div>
        <div class="min-w-0">
          <div id="reviewsEmpty" class="hidden rounded-2xl border border-dashed border-neutral-300 bg-white p-8 text-center">
            <p class="font-semibold">No reviews yet</p>
            <p class="mt-1 text-sm text-neutral-500">Be the first to share how your game went.</p>
          </div>
          <ul id="reviewList" class="space-y-3"></ul>
        </div>
      </div>
      <p id="reviewHint" class="mt-3 hidden text-sm text-neutral-500"></p>
    </section>
 
    <!-- About -->
    <section id="about" class="mx-auto max-w-6xl scroll-mt-20 px-5 pt-14 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">About the venue</h2>
        <p class="mt-4 text-lg leading-relaxed text-neutral-600">
          <%= tenant.description || 'A great place to play, compete and enjoy your game.' %>
        </p>
      </div>
    </section>
 
    <!-- Location -->
    <% if (mapUrl) { %>
      <section id="location" class="mx-auto max-w-6xl scroll-mt-20 px-5 pt-14 lg:px-8">
        <div class="overflow-hidden rounded-2xl bg-white ring-1 ring-neutral-200">
          <% if (mapEmbed) { %>
            <iframe src="<%= mapEmbed %>" title="Map of <%= name %>" loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="h-56 w-full border-0 sm:h-72"></iframe>
          <% } %>
          <div class="flex flex-wrap items-center justify-between gap-4 p-5 sm:p-6">
            <div class="flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-600">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
              </span>
              <div>
                <h2 class="text-lg font-bold">Find us</h2>
                <% if (tenant.address) { %><p class="mt-0.5 text-sm text-neutral-600"><%= tenant.address %></p><% } %>
              </div>
            </div>
            <a href="<%= mapUrl %>" target="_blank" rel="noopener"
               class="rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white hover:bg-blue-700">Get directions</a>
          </div>
        </div>
      </section>
    <% } %>
 
    <!-- Contact -->
    <% if (hasContact) { %>
      <section id="contact" class="mx-auto max-w-6xl scroll-mt-20 px-5 pt-14 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-6 rounded-2xl bg-white p-7 ring-1 ring-neutral-200">
          <div>
            <h2 class="text-2xl font-bold tracking-tight">Need help with your booking?</h2>
            <p class="mt-1 text-sm text-neutral-600">Get in touch with the turf directly.</p>
          </div>
          <div class="flex flex-wrap gap-3">
            <% if (tenant.phone) { %>
              <a href="tel:<%= tenant.phone %>" class="rounded-lg bg-neutral-900 px-5 py-3 text-sm font-semibold text-white hover:bg-neutral-700">Call</a>
            <% } %>
            <% if (waUrl) { %>
              <a href="<%= waUrl %>" target="_blank" rel="noopener" class="rounded-lg bg-green-600 px-5 py-3 text-sm font-semibold text-white hover:bg-green-700">WhatsApp</a>
            <% } %>
            <% if (tenant.email) { %>
              <a href="mailto:<%= tenant.email %>" class="rounded-lg bg-white px-5 py-3 text-sm font-semibold text-neutral-800 ring-1 ring-inset ring-neutral-300 hover:bg-neutral-50">Email</a>
            <% } %>
          </div>
        </div>
      </section>
    <% } %>
 
    <!-- FAQ -->
    <section id="faq" class="mx-auto max-w-6xl scroll-mt-20 px-5 pt-14 lg:px-8">
      <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-neutral-200 overflow-hidden rounded-2xl bg-white ring-1 ring-neutral-200">
        <% faqs.forEach(([question, answer]) => { %>
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left font-semibold text-neutral-900 hover:bg-neutral-50 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600 [&::-webkit-details-marker]:hidden">
              <span><%= question %></span>
              <span class="shrink-0 text-neutral-500 transition-transform group-open:rotate-180"><%- icon('chevron', 'h-5 w-5') %></span>
            </summary>
            <p class="px-5 pb-4 text-sm leading-relaxed text-neutral-600 sm:text-base"><%= answer %></p>
          </details>
        <% }) %>
      </div>
    </section>
 
    <div class="h-28"></div>
  </main>
 
  <!-- Footer: links, social icons, policy -->
  <footer class="border-t border-neutral-200 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-8 lg:px-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
          <p class="truncate text-lg font-bold"><%= name %></p>
          <% if (tenant.address) { %><p class="mt-1 max-w-sm text-sm text-neutral-600"><%= tenant.address %></p><% } %>
          <% if (tenant.phone) { %><p class="mt-1 text-sm text-neutral-600"><a href="tel:<%= tenant.phone %>" class="hover:underline"><%= tenant.phone %></a></p><% } %>
        </div>
 
        <nav aria-label="Footer" class="grid grid-cols-2 gap-x-10 gap-y-2 text-sm font-medium text-neutral-700">
          <a href="#booking" class="hover:text-blue-700">Book a slot</a>
          <a href="#facilities" class="hover:text-blue-700">Facilities</a>
          <a href="#about" class="hover:text-blue-700">About</a>
          <% if (mapUrl) { %><a href="#location" class="hover:text-blue-700">Location</a><% } %>
          <% if (hasContact) { %><a href="#contact" class="hover:text-blue-700">Contact</a><% } %>
          <button type="button" data-refund-open class="text-left hover:text-blue-700">Refund policy</button>
        </nav>
 
        <div class="flex items-center gap-3">
          <% if (waUrl) { %>
          <a href="<%= waUrl %>" target="_blank" rel="noopener" aria-label="WhatsApp" class="social hover:bg-green-600">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
          <% } %>
          <% if (mapUrl) { %>
          <a href="<%= mapUrl %>" target="_blank" rel="noopener" aria-label="Location on map" class="social hover:bg-blue-600">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            </a>
          <% } %>
          <a href="<%= igUrl || 'https://www.instagram.com/' %>" target="_blank" rel="noopener" aria-label="Instagram" class="social hover:bg-pink-600">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
        </div>
      </div>
 
      <p class="mt-8 border-t border-neutral-200 pt-5 text-center text-xs text-neutral-500">
        &copy; <%= new Date().getFullYear() %> <%= name %> &middot; Powered by SquareTurf
      </p>
    </div>
  </footer>
 
  <!-- Floating WhatsApp chat button -->
  <% if (waUrl) { %>
    <a href="<%= waUrl %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"
       class="fixed bottom-24 right-4 z-20 flex h-14 w-14 items-center justify-center rounded-full bg-green-500 text-white shadow-lg hover:bg-green-600">
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
  <% } %>
 
  <!-- Selection bar: appears once slots are selected -->
  <div id="selectionBar" class="selection-bar" hidden>
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 lg:px-8">
      <div class="leading-tight">
        <p id="barCount" class="text-sm text-neutral-500"></p>
        <p class="text-xl font-extrabold tracking-tight">₹<span id="barPrice">0</span></p>
      </div>
      <button id="nextBtn" type="button"
        style="background:var(--accent);color:#fff;"
        class="rounded-lg px-8 py-3 text-sm font-semibold">
        Next
