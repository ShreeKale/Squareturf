  <script>
    /* ================= Banner slideshow ================= */
    (() => {
      'use strict';
 
      const SLIDE_INTERVAL = 2000; // 2 seconds
 
      const root     = document.getElementById('heroCarousel');
      const dotsBox  = root.querySelector('[data-dots]');
      const controls = [...root.querySelectorAll('[data-prev], [data-next]')];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
 
      let slides  = [...root.querySelectorAll('[data-slide]')];
      let current = 0;
      let timer   = null;
 
      function show(index) {
        if (!slides.length) return;
        current = (index + slides.length) % slides.length;
 
        slides.forEach((slide, i) => {
          const active = i === current;
          slide.classList.toggle('opacity-100', active);
          slide.classList.toggle('opacity-0', !active);
          slide.setAttribute('aria-hidden', String(!active));
        });
 
        [...dotsBox.children].forEach((dot, i) => {
          dot.classList.toggle('dot--active', i === current);
          dot.setAttribute('aria-current', String(i === current));
        });
      }
 
      function buildDots() {
        dotsBox.replaceChildren(...slides.map((_, i) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'dot';
          dot.setAttribute('aria-label', `Show photo ${i + 1}`);
          dot.addEventListener('click', () => { show(i); start(); });
          return dot;
        }));
        const many = slides.length > 1;
        dotsBox.style.display = many ? '' : 'none';
        controls.forEach((c) => { c.style.display = many ? '' : 'none'; });
      }
 
      const stop = () => { clearInterval(timer); timer = null; };
 
      function start() {
        stop();
        if (slides.length < 2 || reduceMotion.matches || document.hidden) return;
        timer = setInterval(() => show(current + 1), SLIDE_INTERVAL);
      }
 
      /* A photo that fails to load is removed so the slideshow never shows a broken image */
      function dropSlide(img) {
        slides = slides.filter((s) => s !== img);
        img.remove();
        buildDots();
        show(Math.min(current, Math.max(slides.length - 1, 0)));
        start();
      }
 
      slides.forEach((img) => {
        if (img.complete && img.naturalWidth === 0) dropSlide(img);
        else img.addEventListener('error', () => dropSlide(img), { once: true });
      });
 
      root.querySelector('[data-prev]').addEventListener('click', () => { show(current - 1); start(); });
      root.querySelector('[data-next]').addEventListener('click', () => { show(current + 1); start(); });
 
      /* Pause while the visitor interacts with the banner, or the tab is hidden */
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
 
      buildDots();
      show(0);
      start();
    })();
  </script>
 
  <script>
    /* ================= Customer account: log in, register, user card, history ================= */
    (() => {
      'use strict';
 
      const SLUG = <%- JSON.stringify(tenant.slug) %>;
      const API  = `/api/public/${encodeURIComponent(SLUG)}/customer`;
 
      const $ = (id) => document.getElementById(id);
      const el = {
        loginBtn: $('loginBtn'),
        userMenu: $('userMenu'),
        userBtn: $('userBtn'),
        userCard: $('userCard'),
        userInitial: $('userInitial'),
        userFirstName: $('userFirstName'),
        userFullName: $('userFullName'),
        cardInitial: $('cardInitial'),
        cardName: $('cardName'),
        cardPhone: $('cardPhone'),
        cardEmail: $('cardEmail'),
        historyOpen: $('historyOpen'),
        logoutBtn: $('logoutBtn'),
 
        authModal: $('authModal'),
        authPanel: $('authPanel'),
        authTitle: $('authTitle'),
        authSubtitle: $('authSubtitle'),
        loginForm: $('loginForm'),
        loginPhone: $('loginPhone'),
        loginMessage: $('loginMessage'),
        loginSubmit: $('loginSubmit'),
        registerForm: $('registerForm'),
        registerName: $('registerName'),
        registerPhone: $('registerPhone'),
        registerEmail: $('registerEmail'),
        registerMessage: $('registerMessage'),
        registerSubmit: $('registerSubmit'),
 
        historyModal: $('historyModal'),
        historyPanel: $('historyPanel'),
        historySummary: $('historySummary'),
        historyLoading: $('historyLoading'),
        historyError: $('historyError'),
        historyEmpty: $('historyEmpty'),
        historyList: $('historyList')
      };
 
      /* The logged-in customer (from the server), or null */
      let customer = <%- customerJson %>;
      const listeners = new Set();
 
      /* ---------- Helpers ---------- */
      const firstName = (value) => String(value || '').trim().split(/\s+/)[0];
      const initialOf = (value) => String(value || '?').trim().charAt(0).toUpperCase();
      const formatPhone = (value) => (/^\d{10}$/.test(value) ? `+91 ${value.slice(0, 5)} ${value.slice(5)}` : value);
      const plural = (count, word) => `${count} ${word}${count === 1 ? '' : 's'}`;
 
      const formatDate = (value) =>
        new Date(`${value}T00:00:00`).toLocaleDateString('en-IN', {
          weekday: 'short', day: 'numeric', month: 'short', year: 'numeric'
        });
      const formatTime = (value) => {
        const [h, m] = value.split(':').map(Number);
        const d = new Date();
        d.setHours(h, m, 0, 0);
        return d.toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' });
      };
 
      const anyModalOpen = () => !!document.querySelector('[data-modal]:not(.hidden)');
      const syncScrollLock = () => document.body.classList.toggle('overflow-hidden', anyModalOpen());
 
      function showMessage(box, text, tone = 'error') {
        const tones = {
          error: 'bg-red-50 text-red-700',
          info: 'bg-blue-50 text-blue-800',
          success: 'bg-green-50 text-green-700'
        };
        box.textContent = text;
        box.className = `rounded-lg px-4 py-3 text-sm ${tones[tone]}`;
      }
      const clearMessage = (box) => { box.className = 'hidden'; box.textContent = ''; };
 
      /* All account requests go through here */
      async function api(path, { method = 'GET', body } = {}) {
        if (window.TURF_PREVIEW) throw new Error('Log in is not available in the preview.');
 
        const response = await fetch(`${API}${path}`, {
          method,
          headers: body ? { 'Content-Type': 'application/json' } : undefined,
          body: body ? JSON.stringify(body) : undefined
        });
 
        let data = {};
        try { data = await response.json(); } catch (_) { /* no JSON body */ }
 
        if (!response.ok) {
          const error = new Error(data.message || 'Something went wrong. Please try again.');
          error.code = data.code;
          throw error;
        }
        return data;
      }
 
      /* ---------- Who is logged in ---------- */
      function render() {
        const loggedIn = !!customer;
 
        el.loginBtn.classList.toggle('hidden', loggedIn);
        el.userMenu.classList.toggle('hidden', !loggedIn);
        if (!loggedIn) return;
 
        el.userInitial.textContent = initialOf(customer.name);
        el.userFirstName.textContent = firstName(customer.name);
        el.userFullName.textContent = customer.name;
 
        el.cardInitial.textContent = initialOf(customer.name);
        el.cardName.textContent = customer.name;
        el.cardPhone.textContent = formatPhone(customer.phone);
        el.cardEmail.textContent = customer.email;
      }
 
      function setCustomer(next) {
        customer = next;
        render();
        listeners.forEach((listener) => listener(customer));
      }
 
      /* ---------- User card ---------- */
      function setMenu(open) {
        el.userCard.classList.toggle('hidden', !open);
        el.userBtn.setAttribute('aria-expanded', String(open));
      }
 
      el.userBtn.addEventListener('click', (event) => {
        event.stopPropagation();
        setMenu(el.userCard.classList.contains('hidden'));
      });
 
      document.addEventListener('click', (event) => {
        if (!el.userMenu.contains(event.target)) setMenu(false);
      });
 
      el.userCard.querySelectorAll('[data-menu-link]').forEach((link) =>
        link.addEventListener('click', () => setMenu(false))
      );
 
      el.logoutBtn.addEventListener('click', async () => {
        setMenu(false);
        try { await api('/logout', { method: 'POST' }); } catch (_) { /* log out on screen anyway */ }
        closeHistory();
        setCustomer(null);
      });
 
      /* ---------- Log in / Register popup ---------- */
      const AUTH_TEXT = {
        login:    { title: 'Welcome back', subtitle: 'Enter your phone number to log in.' },
        register: { title: 'Create your account', subtitle: 'Just your name, phone number and email.' }
      };
 
      function setAuthMode(mode) {
        const isLogin = mode === 'login';
 
        el.loginForm.classList.toggle('hidden', !isLogin);
        el.registerForm.classList.toggle('hidden', isLogin);
        el.authTitle.textContent = AUTH_TEXT[mode].title;
        el.authSubtitle.textContent = AUTH_TEXT[mode].subtitle;
 
        el.authModal.querySelectorAll('[data-auth-tab]').forEach((tab) => {
          const active = tab.dataset.authTab === mode;
          tab.classList.toggle('tab--active', active);
          tab.setAttribute('aria-selected', String(active));
        });
 
        (isLogin ? el.loginPhone : el.registerName).focus();
      }
 
      function openAuth(mode = 'login') {
        if (customer) return;
        clearMessage(el.loginMessage);
        clearMessage(el.registerMessage);
        el.authModal.classList.remove('hidden');
        syncScrollLock();
        setAuthMode(mode);
      }
 
      function closeAuth() {
        el.authModal.classList.add('hidden');
        syncScrollLock();
      }
 
      document.addEventListener('click', (event) => {
        const opener = event.target.closest('[data-auth-open]');
        if (opener) openAuth(opener.dataset.authOpen || 'login');
      });
      el.authModal.querySelectorAll('[data-auth-close]').forEach((closer) => closer.addEventListener('click', closeAuth));
      el.authModal.querySelectorAll('[data-auth-tab]').forEach((tab) =>
        tab.addEventListener('click', () => setAuthMode(tab.dataset.authTab))
      );
 
      async function submitAuth(form, button, idleText, busyText, messageBox, request) {
        clearMessage(messageBox);
        button.disabled = true;
        button.textContent = busyText;
 
        try {
          const data = await request();
          form.reset();
          closeAuth();
          setCustomer(data.customer);
        } catch (error) {
          showMessage(messageBox, error.message);
          return error;
        } finally {
          button.disabled = false;
          button.textContent = idleText;
        }
        return null;
      }
 
      el.loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const phone = el.loginPhone.value.trim();
 
        if (!phone) return showMessage(el.loginMessage, 'Please enter your phone number.');
 
        const error = await submitAuth(el.loginForm, el.loginSubmit, 'Log in', 'Logging in…', el.loginMessage,
          () => api('/login', { method: 'POST', body: { phone } }));
 
        /* No account for this number: move to the register form with the number filled in */
        if (error && error.code === 'not_found') {
          setAuthMode('register');
          el.registerPhone.value = phone;
          el.registerName.focus();
          showMessage(el.registerMessage, 'No account found for this number yet. Fill in your details to register.', 'info');
        }
      });
 
      el.registerForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const body = {
          name: el.registerName.value.trim(),
          phone: el.registerPhone.value.trim(),
          email: el.registerEmail.value.trim()
        };
 
        if (!body.name || !body.phone || !body.email) {
          return showMessage(el.registerMessage, 'Please enter your name, phone number and email.');
        }
 
        const error = await submitAuth(el.registerForm, el.registerSubmit, 'Create account', 'Creating account…', el.registerMessage,
          () => api('/register', { method: 'POST', body }));
 
        /* Already registered: move to log in with the number filled in */
        if (error && error.code === 'exists') {
          setAuthMode('login');
          el.loginPhone.value = body.phone;
          showMessage(el.loginMessage, 'This number is already registered. Log in below.', 'info');
        }
      });
 
      /* ---------- Booking history ---------- */
      const STATUS_STYLES = {
        pending:   'bg-amber-50 text-amber-700 ring-amber-600/20',
        confirmed: 'bg-green-50 text-green-700 ring-green-600/20',
        completed: 'bg-blue-50 text-blue-700 ring-blue-600/20',
        cancelled: 'bg-red-50 text-red-700 ring-red-600/20'
      };
      const STATUS_LABELS = { pending: 'Pending', confirmed: 'Confirmed', completed: 'Completed', cancelled: 'Cancelled' };
 
      function node(tag, className, text) {
        const element = document.createElement(tag);
        if (className) element.className = className;
        if (text !== undefined) element.textContent = text;
        return element;
      }
 
      function badge(text, style) {
        return node('span', `inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset ${style}`, text);
      }
 
      function historyItem(booking) {
        const paid = booking.paymentStatus === 'paid';
        const item = node('li', 'rounded-2xl p-4 ring-1 ring-neutral-200');
 
        const top = node('div', 'flex items-start justify-between gap-3');
        top.append(
          node('p', 'font-semibold text-neutral-900', formatDate(booking.date)),
          badge(STATUS_LABELS[booking.status] || booking.status, STATUS_STYLES[booking.status] || STATUS_STYLES.pending)
        );
 
        const time = node('p', 'mt-1 text-sm text-neutral-600',
          `${formatTime(booking.startTime)} – ${formatTime(booking.endTime)} · ${plural(booking.hours, 'hour')}`);
 
        const bottom = node('div', 'mt-3 flex items-center justify-between gap-3');
        bottom.append(
          node('p', 'font-bold text-neutral-900', `₹${Number(booking.amount).toLocaleString('en-IN')}`),
          badge(paid ? 'Paid' : 'Unpaid', paid
            ? 'bg-green-50 text-green-700 ring-green-600/20'
            : 'bg-neutral-100 text-neutral-600 ring-neutral-500/20')
        );
 
        item.append(top, time, bottom);
        return item;
      }
 
      function setHistoryLoading(loading) {
        el.historyLoading.classList.toggle('hidden', !loading);
        el.historyLoading.classList.toggle('flex', loading);
      }
 
      async function openHistory() {
        if (!customer) return;
 
        el.historyModal.classList.remove('hidden');
        syncScrollLock();
        el.historyPanel.focus();
 
        el.historyList.replaceChildren();
        el.historyEmpty.classList.add('hidden');
        el.historyError.classList.add('hidden');
        el.historySummary.textContent = '';
        setHistoryLoading(true);
 
        try {
          const data = await api('/bookings');
 
          el.historyList.replaceChildren(...data.bookings.map(historyItem));
          el.historyEmpty.classList.toggle('hidden', data.bookings.length > 0);
          el.historySummary.textContent = data.bookings.length
            ? `${plural(data.totals.bookings, 'booking')} · ${plural(data.totals.hours, 'hour')} in total`
            : '';
        } catch (error) {
          el.historyError.textContent = error.message;
          el.historyError.classList.remove('hidden');
        } finally {
          setHistoryLoading(false);
        }
      }
 
      function closeHistory() {
        el.historyModal.classList.add('hidden');
        syncScrollLock();
      }
 
      el.historyOpen.addEventListener('click', () => { setMenu(false); openHistory(); });
      el.historyModal.querySelectorAll('[data-history-close]').forEach((closer) => closer.addEventListener('click', closeHistory));
 
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        setMenu(false);
        if (!el.authModal.classList.contains('hidden')) closeAuth();
        else if (!el.historyModal.classList.contains('hidden')) closeHistory();
      });
 
      /* The booking form below reads the logged-in customer from here */
      window.TurfAccount = {
        get customer() { return customer; },
        onChange(listener) { listeners.add(listener); }
      };
 
      render();
    })();
  </script>
 
  <script>
    /* ================= Slot booking ================= */
    (() => {
      'use strict';
 
      /* ---------- Config ---------- */
      const SLUG  = <%- JSON.stringify(tenant.slug) %>;
      const PRICE = <%= price %>;
      const PAST_CHECK_MS = 30000; // re-check for slots whose time has gone
      const PREVIEW = window.TURF_PREVIEW;
      const OPENING = <%- JSON.stringify(tenant.openingTime || '06:00') %>;
      const CLOSING = <%- JSON.stringify(tenant.closingTime || '23:00') %>;
      const OPEN_DAYS = <%- JSON.stringify(tenant.operatingDays || []) %>;
 
      /* ---------- Elements ---------- */
      const $ = (id) => document.getElementById(id);
      const el = {
        date: $('bookingDate'),
        grid: $('slotGrid'),
        loading: $('slotLoading'),
        error: $('slotError'),
        empty: $('slotEmpty'),
        bar: $('selectionBar'),
        barCount: $('barCount'),
        barPrice: $('barPrice'),
        next: $('nextBtn'),
        modal: $('bookingModal'),
        panel: $('modalPanel'),
        formView: $('formView'),
        successView: $('successView'),
        successText: $('successText'),
        summaryDate: $('summaryDate'),
        summaryTime: $('summaryTime'),
        summaryDuration: $('summaryDuration'),
        summaryPrice: $('summaryPrice'),
        form: $('bookingForm'),
        submit: $('bookingSubmit'),
        message: $('bookingMessage'),
        name: $('customerName'),
        phone: $('customerPhone'),
        email: $('customerEmail'),
        guestFields: $('guestFields'),
        memberBox: $('memberBox'),
        memberInitial: $('memberInitial'),
        memberName: $('memberName'),
        memberContact: $('memberContact')
      };
 
      const account = window.TurfAccount; // who is logged in (see the account script above)
 
      /* ---------- State ---------- */
      let allSlots = [];       // everything the server returned for the chosen date
      let selectedSlots = [];
 
      const SLOT_STATES = {
        available: 'Available',
        selected: 'Selected',
        booked: 'Booked'
      };
 
      /* ---------- Helpers ---------- */
      const pad = (n) => String(n).padStart(2, '0');
 
      const localToday = () => {
        const d = new Date();
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
      };
 
      const toMinutes = (value) => {
        const [h, m] = value.split(':').map(Number);
        return h * 60 + m;
      };
 
      /* A slot is gone once its start time has passed (only relevant for today) */
      const isPast = (slot) => {
        if (el.date.value !== localToday()) return false;
        const now = new Date();
        return toMinutes(slot.startTime) <= now.getHours() * 60 + now.getMinutes();
      };
 
      const formatDate = (value) =>
        new Date(`${value}T00:00:00`).toLocaleDateString('en-IN', {
          weekday: 'short', day: 'numeric', month: 'short', year: 'numeric'
        });
 
      const formatTime = (value) => {
        const [h, m] = value.split(':').map(Number);
        const d = new Date();
        d.setHours(h, m, 0, 0);
        return d.toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' });
      };
 
      const plural = (count, word) => `${count} ${word}${count === 1 ? '' : 's'}`;
      const isSameSlot = (a, b) => a.startTime === b.startTime && a.endTime === b.endTime;
 
      /* Merge back-to-back slots into ranges: 6–7 + 7–8 => "6 pm – 8 pm" */
      function toRanges(slots) {
        const sorted = [...slots].sort((a, b) => toMinutes(a.startTime) - toMinutes(b.startTime));
        const ranges = [];
        let { startTime: start, endTime: end } = sorted[0];
 
        for (const slot of sorted.slice(1)) {
          if (slot.startTime === end) {
            end = slot.endTime;
          } else {
            ranges.push(`${formatTime(start)} – ${formatTime(end)}`);
            start = slot.startTime;
            end = slot.endTime;
          }
        }
        ranges.push(`${formatTime(start)} – ${formatTime(end)}`);
        return ranges;
      }
 
      /* ---------- UI updates ---------- */
      function setLoading(isLoading) {
        el.loading.classList.toggle('hidden', !isLoading);
        el.loading.classList.toggle('flex', isLoading);
      }
 
      function showError(text) {
        el.error.textContent = text;
        el.error.classList.remove('hidden');
      }
 
      function showMessage(text, success = false) {
        el.message.textContent = text;
        el.message.className = `rounded-lg px-4 py-3 text-sm ${
          success ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'
        }`;
      }
 
      /* Logged in: show "Booking as ..." instead of the name, phone and email fields */
      function renderBookingAs() {
        const customer = account.customer;
 
        el.memberBox.classList.toggle('hidden', !customer);
        el.memberBox.classList.toggle('flex', !!customer);
        el.guestFields.classList.toggle('hidden', !!customer);
        if (!customer) return;
 
        el.memberInitial.textContent = String(customer.name || '?').trim().charAt(0).toUpperCase();
        el.memberName.textContent = customer.name;
        el.memberContact.textContent = `${customer.phone} · ${customer.email}`;
      }
 
 
      function updateSummary() {
        el.summaryDate.textContent = el.date.value ? formatDate(el.date.value) : 'Select a date';
 
        const count = selectedSlots.length;
        el.bar.hidden = count === 0;
 
        if (!count) {
          el.summaryTime.textContent = 'No slots selected';
          el.summaryDuration.textContent = '0 hours';
          el.summaryPrice.textContent = '0';
          el.barPrice.textContent = '0';
          return;
        }
 
        const total = (PRICE * count).toLocaleString('en-IN');
        el.summaryTime.textContent = toRanges(selectedSlots).join(', ');
        el.summaryDuration.textContent = plural(count, 'hour');
        el.summaryPrice.textContent = total;
        el.barCount.textContent = plural(count, 'slot') + ' selected';
        el.barPrice.textContent = total;
        el.submit.textContent = `Request ${plural(count, 'slot')}`;
      }
 
      /* ---------- Popup ---------- */
      const anyModalOpen = () => !!document.querySelector('[data-modal]:not(.hidden)');
 
      function openModal() {
        if (!selectedSlots.length) return;
        updateSummary();
        renderBookingAs();
        el.message.className = 'hidden';
        el.formView.classList.remove('hidden');
        el.successView.classList.add('hidden');
        el.modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
        el.panel.focus();
      }
 
      function closeModal() {
        el.modal.classList.add('hidden');
        document.body.classList.toggle('overflow-hidden', anyModalOpen());
      }
 
      /* Logging in or out while the booking popup is open updates it straight away */
      account.onChange(() => {
        renderBookingAs();
        el.message.className = 'hidden';
      });
 
      /* ---------- Slots ---------- */
      function setSlotState(button, state) {
        button.className = `slot slot--${state}`;
        button.querySelector('.slot-status').textContent = SLOT_STATES[state];
        button.setAttribute('aria-pressed', String(state === 'selected'));
      }
 
      function toggleSlot(slot, button) {
        const index = selectedSlots.findIndex((s) => isSameSlot(s, slot));
 
        if (index >= 0) {
          selectedSlots.splice(index, 1);
          setSlotState(button, 'available');
        } else {
          selectedSlots.push(slot);
          setSlotState(button, 'selected');
        }
        updateSummary();
      }
 
      function createSlotButton(slot) {
        const button = document.createElement('button');
        button.type = 'button';
 
        const status = document.createElement('div');
        status.className = 'slot-status';
 
        const time = document.createElement('div');
        time.className = 'slot-time';
        time.textContent = formatTime(slot.startTime);
 
        const end = document.createElement('div');
        end.className = 'slot-end';
        end.textContent = `to ${formatTime(slot.endTime)}`;
 
        button.append(status, time, end);
 
        if (slot.available) {
          const isSelected = selectedSlots.some((s) => isSameSlot(s, slot));
          setSlotState(button, isSelected ? 'selected' : 'available');
          button.addEventListener('click', () => toggleSlot(slot, button));
        } else {
          setSlotState(button, 'booked');
          button.disabled = true;
        }
        return button;
      }
 
      /* Draws the slots, leaving out any whose time has already passed */
      function renderSlots() {
        const visible = allSlots.filter((slot) => !isPast(slot));
 
        selectedSlots = selectedSlots.filter((sel) =>
          visible.some((v) => v.available && isSameSlot(v, sel))
        );
 
        el.grid.replaceChildren(...visible.map(createSlotButton));
        el.empty.classList.toggle('hidden', visible.length > 0);
        updateSummary();
      }
 
      /* Preview only: every hour between opening and closing is free, and closed days have none */
      function previewSlots(date) {
        const dayKeys = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
        const [y, m, d] = date.split('-').map(Number);
        if (OPEN_DAYS.length && !OPEN_DAYS.includes(dayKeys[new Date(y, m - 1, d).getDay()])) return [];
 
        const slots = [];
        for (let start = toMinutes(OPENING); start + 60 <= toMinutes(CLOSING); start += 60) {
          const label = (minutes) => `${pad(Math.floor(minutes / 60))}:${pad(minutes % 60)}`;
          slots.push({ startTime: label(start), endTime: label(start + 60), available: true });
        }
        return slots;
      }
 
      async function loadSlots() {
        const date = el.date.value;
        if (!date) return;
 
        selectedSlots = [];
        allSlots = [];
        updateSummary();
        el.grid.replaceChildren();
        el.empty.classList.add('hidden');
        el.error.classList.add('hidden');
        setLoading(true);
 
        try {
          if (PREVIEW) {
            allSlots = previewSlots(date);
            renderSlots();
            return;
          }
 
          const response = await fetch(
            `/api/public/${encodeURIComponent(SLUG)}/availability?date=${encodeURIComponent(date)}`
          );
          const data = await response.json();
          if (!response.ok) throw new Error(data.message || 'Unable to load availability.');
          allSlots = data.slots || [];
          renderSlots();
        } catch (error) {
          showError(error.message || 'Unable to load slots.');
        } finally {
          setLoading(false);
        }
      }
 
      /* Remove slots as their time passes while the page stays open */
      setInterval(() => {
        if (!allSlots.length) return;
        const hadSelection = selectedSlots.length > 0;
        renderSlots();
 
        const formOpen = !el.modal.classList.contains('hidden') && !el.formView.classList.contains('hidden');
        if (hadSelection && !selectedSlots.length && formOpen) {
          closeModal();
          showError('The time for your selected slot has passed. Please choose another slot.');
        }
      }, PAST_CHECK_MS);
 
      /* ---------- Booking request ---------- */
      async function submitBooking(event) {
        event.preventDefault();
 
        if (!selectedSlots.length) {
          return showMessage('Please select at least one available slot.');
        }
 
        /* Logged in: the server uses the saved details. Otherwise they come from the form. */
        const details = {};
 
        if (!account.customer) {
          details.customerName  = el.name.value.trim();
          details.customerPhone = el.phone.value.trim();
          details.customerEmail = el.email.value.trim();
 
          if (!details.customerName || !details.customerPhone) {
            return showMessage('Please enter your name and phone number.');
          }
        }
 
        if (PREVIEW) {
          el.successText.textContent = 'This is a preview, so no booking was made.';
          el.formView.classList.add('hidden');
          el.successView.classList.remove('hidden');
          return;
        }
 
        el.submit.disabled = true;
        el.submit.textContent = 'Sending request…';
        let failure = null;
 
        try {
          const response = await fetch(`/public-booking/${encodeURIComponent(SLUG)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...details,
              date: el.date.value,
              slots: selectedSlots.map(({ startTime, endTime }) => ({ startTime, endTime }))
            })
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.message || 'Booking failed.');
 
          el.form.reset();
          el.successText.textContent = data.message || 'Booking request sent. The turf owner will confirm it.';
          el.formView.classList.add('hidden');
          el.successView.classList.remove('hidden');
        } catch (error) {
          failure = error.message || 'Something went wrong.';
        } finally {
          el.submit.disabled = false;
          await loadSlots(); // refresh availability and reset selection either way
        }
 
        if (failure) {
          closeModal();
          showError(failure);
        }
      }
 
      /* ---------- Init ---------- */
      /* Date strip: today and the next 20 days, using the visitor's own date */
      const DAYS_AHEAD = 20;
      const DAY_KEYS = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
      const strip = $('dateStrip');
      const dateLabel = $('dateLabel');
 
      const isOpenDay = (date) => !OPEN_DAYS.length || OPEN_DAYS.includes(DAY_KEYS[date.getDay()]);
      const dateValue = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
 
      function pickDate(value, fromUser) {
        el.date.value = value;
        let active = null;
 
        strip.querySelectorAll('[data-date]').forEach((chip) => {
          const on = chip.dataset.date === value;
          if (on) active = chip;
          if (!chip.disabled) chip.className = `day ${on ? 'day--active' : ''}`;
          chip.setAttribute('aria-pressed', String(on));
        });
 
        dateLabel.textContent = new Date(`${value}T00:00:00`).toLocaleDateString('en-IN', {
          weekday: 'long', day: 'numeric', month: 'long'
        });
 
        if (active) {
          /* Scroll the strip itself (not the page) so the chosen day is in view */
          strip.scrollLeft = active.offsetLeft - strip.clientWidth / 2 + active.clientWidth / 2;
        }
        if (fromUser) loadSlots();
      }
 
      function buildDateStrip() {
        const start = new Date();
        const chips = [];
        let first = null;
 
        for (let i = 0; i <= DAYS_AHEAD; i += 1) {
          const date = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);
          const value = dateValue(date);
          const open = isOpenDay(date);
          if (open && !first) first = value;
 
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.dataset.date = value;
          chip.className = 'day';
 
          const weekday = document.createElement('span');
          weekday.className = 'text-[11px] font-semibold uppercase tracking-wide opacity-80';
          weekday.textContent = i === 0 ? 'Today' : date.toLocaleDateString('en-IN', { weekday: 'short' });
 
          const dayNumber = document.createElement('span');
          dayNumber.className = 'text-xl font-extrabold leading-tight';
          dayNumber.textContent = String(date.getDate());
 
          const month = document.createElement('span');
          month.className = 'text-[11px] font-medium uppercase opacity-80';
          month.textContent = open ? date.toLocaleDateString('en-IN', { month: 'short' }) : 'Closed';
 
          chip.append(weekday, dayNumber, month);
          chip.setAttribute('aria-label', `${date.toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long' })}${open ? '' : ', closed'}`);
 
          if (open) {
            chip.addEventListener('click', () => pickDate(value, true));
          } else {
            chip.disabled = true;
            chip.className = 'day day--off';
          }
          chips.push(chip);
        }
 
        strip.replaceChildren(...chips);
        return first || dateValue(start);
      }
 
      $('dayPrev').addEventListener('click', () => strip.scrollBy({ left: -strip.clientWidth * 0.8 }));
      $('dayNext').addEventListener('click', () => strip.scrollBy({ left: strip.clientWidth * 0.8 }));
 
      pickDate(buildDateStrip(), false);
 
      el.date.addEventListener('change', loadSlots);
      el.form.addEventListener('submit', submitBooking);
      el.next.addEventListener('click', openModal);
      el.modal.querySelectorAll('[data-close]').forEach((node) => node.addEventListener('click', closeModal));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !el.modal.classList.contains('hidden') && document.getElementById('authModal').classList.contains('hidden')) {
          closeModal();
        }
      });
      renderBookingAs();
      loadSlots();
    })();
  </script>
 
  <script>
    /* ================= Refund popup, photo viewer, reviews ================= */
    (() => {
      'use strict';
 
      const $ = (id) => document.getElementById(id);
      const SLUG = <%- JSON.stringify(tenant.slug) %>;
      const PHOTOS = <%- JSON.stringify(venuePhotos).replace(/</g, '\\u003c') %>;
      const STAR = 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z';
 
      const anyModalOpen = () => !!document.querySelector('[data-modal]:not(.hidden)');
      const syncScrollLock = () => document.body.classList.toggle('overflow-hidden', anyModalOpen());
 
      function node(tag, className, text) {
        const element = document.createElement(tag);
        if (className) element.className = className;
        if (text !== undefined) element.textContent = text;
        return element;
      }
 
      /* A row of 5 stars, filled up to `value` */
      function stars(value, size = 'h-4 w-4') {
        const row = node('span', 'inline-flex items-center gap-0.5');
        row.setAttribute('role', 'img');
        row.setAttribute('aria-label', `${value} out of 5 stars`);
        for (let i = 1; i <= 5; i += 1) {
          const filled = i <= Math.round(value);
          row.insertAdjacentHTML('beforeend',
            `<svg class="${size} ${filled ? 'text-amber-400' : 'text-neutral-300'}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="${STAR}"/></svg>`);
        }
        return row;
      }
 
      /* ---------- Refund policy popup ---------- */
      const refundModal = $('refundModal');
      if (refundModal) {
        const refundPanel = $('refundPanel');
        const openRefund = () => { refundModal.classList.remove('hidden'); syncScrollLock(); refundPanel.focus(); };
        const closeRefund = () => { refundModal.classList.add('hidden'); syncScrollLock(); };
 
        document.querySelectorAll('[data-refund-open]').forEach((button) => button.addEventListener('click', openRefund));
        refundModal.querySelectorAll('[data-refund-close]').forEach((closer) => closer.addEventListener('click', closeRefund));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !refundModal.classList.contains('hidden')) closeRefund();
        });
      }
 
      /* ---------- Photo viewer ---------- */
      const lightbox = $('lightbox');
      if (lightbox && PHOTOS.length) {
        const image = lightbox.querySelector('[data-lb-image]');
        const count = lightbox.querySelector('[data-lb-count]');
        let index = 0;
 
        const show = (next) => {
          index = (next + PHOTOS.length) % PHOTOS.length;
          image.src = PHOTOS[index];
          image.alt = `Photo ${index + 1} of ${PHOTOS.length}`;
          count.textContent = `${index + 1} / ${PHOTOS.length}`;
        };
        const open = (start) => { show(start); lightbox.classList.remove('hidden'); syncScrollLock(); };
        const close = () => { lightbox.classList.add('hidden'); syncScrollLock(); };
 
        document.querySelectorAll('[data-lightbox]').forEach((button) =>
          button.addEventListener('click', () => open(Number(button.dataset.lightbox) || 0)));
        lightbox.querySelector('[data-lb-close]').addEventListener('click', close);
        lightbox.querySelector('[data-lb-prev]').addEventListener('click', () => show(index - 1));
        lightbox.querySelector('[data-lb-next]').addEventListener('click', () => show(index + 1));
        lightbox.querySelector('[data-lb-stage]').addEventListener('click', (event) => { if (event.target === event.currentTarget) close(); });
 
        document.addEventListener('keydown', (event) => {
          if (lightbox.classList.contains('hidden')) return;
          if (event.key === 'Escape') close();
          if (event.key === 'ArrowLeft') show(index - 1);
          if (event.key === 'ArrowRight') show(index + 1);
        });
 
        /* Swipe on a phone */
        let startX = null;
        lightbox.addEventListener('touchstart', (event) => { startX = event.touches[0].clientX; }, { passive: true });
        lightbox.addEventListener('touchend', (event) => {
          if (startX === null) return;
          const moved = event.changedTouches[0].clientX - startX;
          startX = null;
          if (Math.abs(moved) > 50) show(index + (moved < 0 ? 1 : -1));
        });
      }
 
      /* ---------- Reviews ---------- */
      const el = {
        summary: $('ratingSummary'), list: $('reviewList'), empty: $('reviewsEmpty'), hint: $('reviewHint'),
        write: $('writeReview'),
        modal: $('reviewModal'), panel: $('reviewPanel'), form: $('reviewForm'), picker: $('starPicker'),
        comment: $('reviewComment'), message: $('reviewMessage'), submit: $('reviewSubmit'), title: $('reviewTitle')
      };
 
      const PREVIEW = window.TURF_PREVIEW;
      const API = `/api/public/${encodeURIComponent(SLUG)}/reviews`;
      let state = { loggedIn: false, canReview: false, mine: null };
      let chosen = 0;
 
      function renderSummary(summary) {
        el.summary.replaceChildren();
 
        if (!summary.count) {
          el.summary.append(node('p', 'font-semibold', 'No ratings yet'), node('p', 'mt-1 text-sm text-neutral-500', 'Ratings appear after players review this turf.'));
          return;
        }
 
        const top = node('div', 'flex items-center gap-4');
        const bigNumber = node('p', 'text-5xl font-extrabold tracking-tight', summary.average.toFixed(1));
        const side = node('div');
        side.append(stars(summary.average, 'h-5 w-5'), node('p', 'mt-1 text-sm text-neutral-500', `${summary.count} ${summary.count === 1 ? 'review' : 'reviews'}`));
        top.append(bigNumber, side);
 
        const bars = node('div', 'mt-5 space-y-2');
        [5, 4, 3, 2, 1].forEach((level) => {
          const share = Math.round(((summary.breakdown[level] || 0) / summary.count) * 100);
          const row = node('div', 'flex items-center gap-3 text-sm');
          const track = node('div', 'h-2 flex-1 overflow-hidden rounded-full bg-neutral-200');
          const fill = node('div', 'h-full rounded-full bg-amber-400');
          fill.style.width = `${share}%`;
          track.append(fill);
          row.append(node('span', 'w-8 shrink-0 text-neutral-600', `${level} ★`), track, node('span', 'w-9 shrink-0 text-right text-neutral-500', `${share}%`));
          bars.append(row);
        });
 
        el.summary.append(top, bars);
      }
 
      function reviewCard(review) {
        const card = node('li', 'rounded-2xl bg-white p-4 ring-1 ring-neutral-200 sm:p-5');
        const head = node('div', 'flex items-start justify-between gap-3');
        const who = node('div', 'flex min-w-0 items-center gap-3');
        who.append(
          node('span', 'flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-bold text-white', review.name.charAt(0).toUpperCase()),
          node('span', 'truncate font-semibold', review.name)
        );
        head.append(who, node('span', 'shrink-0 text-xs text-neutral-500',
          new Date(review.createdAt).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })));
        card.append(head, node('div', 'mt-2', undefined));
        card.lastChild.append(stars(review.rating));
        if (review.comment) card.append(node('p', 'mt-2 whitespace-pre-line break-words text-sm leading-relaxed text-neutral-700', review.comment));
        return card;
      }
 
      function renderAction() {
        el.hint.classList.add('hidden');
        el.write.classList.remove('hidden');
        delete el.write.dataset.authOpen;
 
        if (!state.loggedIn) {
          el.write.dataset.authOpen = 'login';
          el.write.textContent = 'Log in to write a review';
        } else if (state.canReview) {
          el.write.textContent = state.mine ? 'Edit your review' : 'Write a review';
        } else {
          el.write.classList.add('hidden');
          el.hint.textContent = 'You can write a review after one of your bookings is confirmed.';
          el.hint.classList.remove('hidden');
        }
      }
 
      async function loadReviews() {
        if (PREVIEW) {
          renderSummary({ count: 0 });
          el.empty.classList.remove('hidden');
          return;
        }
        try {
          const response = await fetch(API);
          const data = await response.json();
          if (!response.ok) throw new Error(data.message);
 
          state = { loggedIn: data.loggedIn, canReview: data.canReview, mine: data.mine };
          renderSummary(data.summary);
          el.list.replaceChildren(...data.reviews.map(reviewCard));
          el.empty.classList.toggle('hidden', data.reviews.length > 0);
          renderAction();
        } catch (_) {
          el.summary.replaceChildren(node('p', 'text-sm text-neutral-500', 'Reviews could not be loaded right now.'));
        }
      }
 
      /* Star picker */
      function drawPicker() {
        el.picker.replaceChildren(...[1, 2, 3, 4, 5].map((value) => {
          const button = node('button', 'rounded p-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600');
          button.type = 'button';
          button.setAttribute('role', 'radio');
          button.setAttribute('aria-checked', String(chosen === value));
          button.setAttribute('aria-label', `${value} ${value === 1 ? 'star' : 'stars'}`);
          button.innerHTML = `<svg class="h-9 w-9 ${value <= chosen ? 'text-amber-400' : 'text-neutral-300'}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="${STAR}"/></svg>`;
          button.addEventListener('click', () => { chosen = value; drawPicker(); });
          return button;
        }));
      }
 
      function showMessage(text, ok) {
        el.message.textContent = text;
        el.message.className = `rounded-lg px-4 py-3 text-sm ${ok ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'}`;
      }
 
      function openReview() {
        chosen = state.mine ? state.mine.rating : 0;
        el.comment.value = state.mine ? state.mine.comment : '';
        el.title.textContent = state.mine ? 'Edit your review' : 'Rate your experience';
        el.message.className = 'hidden';
        drawPicker();
        el.modal.classList.remove('hidden');
        syncScrollLock();
        el.panel.focus();
      }
      const closeReview = () => { el.modal.classList.add('hidden'); syncScrollLock(); };
 
      el.write.addEventListener('click', () => { if (!el.write.dataset.authOpen) openReview(); });
      el.modal.querySelectorAll('[data-review-close]').forEach((closer) => closer.addEventListener('click', closeReview));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !el.modal.classList.contains('hidden')) closeReview();
      });
 
      el.form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!chosen) return showMessage('Please choose a star rating.', false);
 
        el.submit.disabled = true;
        el.submit.textContent = 'Saving…';
        try {
          const response = await fetch(API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rating: chosen, comment: el.comment.value.trim() })
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.message || 'Could not save your review.');
 
          closeReview();
          await loadReviews();
          $('reviews').scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (error) {
          showMessage(error.message, false);
        } finally {
          el.submit.disabled = false;
          el.submit.textContent = 'Submit review';
        }
      });
 
      /* Logging in or out changes what the review button does */
      if (window.TurfAccount) window.TurfAccount.onChange(loadReviews);
      loadReviews();
    })();
  </script>
 
</body>
</html>
 