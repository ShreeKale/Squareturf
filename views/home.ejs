<!-- ================= Less infrastructure ================= -->
<section id="platform" class="mx-auto max-w-7xl scroll-mt-16 px-4 py-10 sm:px-6 sm:py-12 md:py-16 lg:px-8">
  <div class="max-w-3xl">
    <h2 class="text-2xl font-extrabold leading-tight tracking-tight text-neutral-900 sm:text-4xl">
      Less Infrastructure. Lower Costs. More Focus on Your Turf.
    </h2>
    <p class="mt-4 text-base leading-relaxed text-neutral-600 sm:text-lg">
      SquareTurf simplifies the technology behind your turf business. Instead of setting up and managing multiple technical services independently, you can manage your online presence through one platform.
    </p>
  </div>
 
  <ul class="mt-6 grid grid-cols-2 gap-3 sm:mt-8 sm:gap-4 lg:grid-cols-4">
    <% managed.forEach(([icon, heading, text]) => { %>
      <li class="min-w-0 rounded-2xl bg-white p-3.5 ring-1 ring-neutral-200 sm:p-5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-blue-600 sm:h-11 sm:w-11">
          <i data-lucide="<%= icon %>" class="h-4 w-4 sm:h-5 sm:w-5"></i>
        </span>
        <h3 class="mt-3 text-sm font-bold leading-snug text-neutral-900 sm:mt-4 sm:text-lg"><%= heading %></h3>
        <p class="mt-1 text-xs leading-relaxed text-neutral-600 sm:mt-1.5 sm:text-sm"><%= text %></p>
      </li>
    <% }) %>
  </ul>
</section>
 
<!-- ================= How it works ================= -->
<section id="how-it-works" class="mx-auto max-w-7xl scroll-mt-16 px-4 py-10 sm:px-6 sm:py-12 md:py-16 lg:px-8">
  <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">How it works</p>
  <h2 class="mt-2 max-w-2xl text-3xl font-extrabold tracking-tight sm:text-4xl">Go live in four simple steps</h2>
  <ol class="mt-6 grid grid-cols-2 gap-3 sm:mt-8 sm:gap-6 lg:grid-cols-4">
    <% steps.forEach(([heading, text], index) => { %>
      <li class="relative min-w-0 rounded-2xl bg-white p-4 ring-1 ring-neutral-200 sm:p-6">
