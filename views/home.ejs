<script>
  /* Sample booking in the website demo: nothing is sent anywhere */
  (() => {
    'use strict';
 
    const PRICE = 1200;
    const HOURS = [6, 7, 8, 17, 18, 19, 20, 21, 22]; // sample opening hours, one slot each
 
    const dates = document.getElementById('demoDates');
    const grid = document.getElementById('demoSlots');
    const summary = document.getElementById('demoSummary');
    const button = document.getElementById('demoButton');
    if (!dates || !grid) return;
 
    /* 6 -> "6am", 21 -> "9pm", 24 -> "12am" */
    const clock = (h) => {
      const hour = h % 24;
      return `${hour % 12 || 12}${hour < 12 ? 'am' : 'pm'}`;
    };
    /* One slot = one hour, shown as "6am–7am" */
    const slotLabel = (h) => `${clock(h)}–${clock(h + 1)}`;
 
    let dayIndex = 0;
    let picked = new Set();
 
    /* A fixed pattern of taken slots that changes with the day, so every date looks different */
    const isTaken = (day, h) => (h * 7 + day * 5) % 4 === 0;
 
    function drawSlots() {
      grid.replaceChildren(...HOURS.map((h) => {
        const slot = document.createElement('button');
        slot.type = 'button';
        const taken = isTaken(dayIndex, h);
        const on = picked.has(h);
        slot.textContent = slotLabel(h);
        slot.setAttribute('aria-pressed', String(on));
        slot.className = 'min-h-[44px] rounded-lg px-1 py-2.5 text-center text-[13px] font-medium transition-colors sm:px-2 sm:py-3 sm:text-sm ' + (
          taken ? 'cursor-not-allowed bg-neutral-100 text-neutral-400 line-through'
          : on ? 'bg-blue-600 text-white shadow-md ring-1 ring-inset ring-blue-600'
          : 'bg-white text-neutral-900 ring-1 ring-inset ring-neutral-300 hover:ring-blue-600');
        if (taken) slot.disabled = true;
        else slot.addEventListener('click', () => { picked.has(h) ? picked.delete(h) : picked.add(h); drawSlots(); });
        return slot;
      }));
 
      const count = picked.size;
      summary.textContent = count
        ? `${count} ${count === 1 ? 'slot' : 'slots'} selected · ₹${(count * PRICE).toLocaleString('en-IN')}`
        : 'No slot selected yet.';
      button.className = 'rounded-lg px-4 py-2 text-sm font-semibold ' + (count ? 'bg-neutral-900 text-white' : 'bg-neutral-200 text-neutral-500');
    }
 
    function drawDates() {
      const now = new Date();
      dates.replaceChildren(...Array.from({ length: 10 }, (_, i) => {
        const day = new Date(now.getFullYear(), now.getMonth(), now.getDate() + i);
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.setAttribute('aria-pressed', String(i === dayIndex));
        chip.className = 'flex min-w-[3.75rem] shrink-0 snap-start flex-col items-center rounded-xl border px-2 py-2.5 text-center transition-colors sm:min-w-[4.25rem] ' +
          (i === dayIndex ? 'border-blue-600 bg-blue-600 text-white shadow-md' : 'border-neutral-300 bg-white hover:border-blue-600');
 
        const top = document.createElement('span');
        top.className = 'text-[11px] font-semibold uppercase tracking-wide opacity-80';
        top.textContent = i === 0 ? 'Today' : day.toLocaleDateString('en-IN', { weekday: 'short' });
        const num = document.createElement('span');
        num.className = 'text-xl font-extrabold leading-tight';
        num.textContent = String(day.getDate());
        const month = document.createElement('span');
        month.className = 'text-[11px] font-medium uppercase opacity-80';
        month.textContent = day.toLocaleDateString('en-IN', { month: 'short' });
        chip.append(top, num, month);
 
        chip.addEventListener('click', () => { dayIndex = i; picked = new Set(); drawDates(); drawSlots(); });
        return chip;
      }));
    }
 
    /* Arrow buttons for mouse users (phones swipe) */
    document.getElementById('demoPrev').addEventListener('click', () => dates.scrollBy({ left: -dates.clientWidth * 0.8 }));
    document.getElementById('demoNext').addEventListener('click', () => dates.scrollBy({ left: dates.clientWidth * 0.8 }));
 
    drawDates();
    drawSlots();
  })();
</script>
 
<script>
  /* Pricing on phones: open on the middle plan, and keep the dots in step with the swiping */
  (() => {
    'use strict';
 
    const scroller = document.getElementById('planScroller');
    const dotsBox = document.getElementById('planDots');
    if (!scroller || !dotsBox) return;
 
    const cards = [...scroller.querySelectorAll('[data-plan]')];
    const phone = window.matchMedia('(max-width: 639px)');
    const centreOf = (card) => card.offsetLeft - (scroller.clientWidth - card.offsetWidth) / 2;
    const middleOf = (card) => card.offsetLeft + card.offsetWidth / 2;
 
    const dots = cards.map((card) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('aria-label', `Show ${card.querySelector('h3').textContent} plan`);
      dot.addEventListener('click', () => scroller.scrollTo({ left: centreOf(card), behavior: 'smooth' }));
      dotsBox.append(dot);
      return dot;
    });
 
    function mark() {
      const centre = scroller.scrollLeft + scroller.clientWidth / 2;
      let nearest = 0;
      cards.forEach((card, i) => {
        if (Math.abs(middleOf(card) - centre) < Math.abs(middleOf(cards[nearest]) - centre)) nearest = i;
      });
      dots.forEach((dot, i) => {
        dot.className = 'h-2 rounded-full transition-all ' + (i === nearest ? 'w-6 bg-neutral-900' : 'w-2 bg-neutral-300');
        dot.setAttribute('aria-current', String(i === nearest));
      });
    }
 
    /* Put the middle (most popular) plan on screen, instantly. Runs again once the page has
       finished loading, because fonts and icons can shift the layout after the first run. */
    function openOnMiddle() {
      if (!phone.matches) return;
      scroller.scrollLeft = centreOf(cards[1] || cards[0]);
      mark();
    }
 
    let waiting = false;
    scroller.addEventListener('scroll', () => {
      if (waiting) return;
      waiting = true;
      requestAnimationFrame(() => { waiting = false; mark(); });
    }, { passive: true });
 
    openOnMiddle();
    requestAnimationFrame(openOnMiddle);
    window.addEventListener('load', openOnMiddle);
    window.addEventListener('pageshow', openOnMiddle);
    phone.addEventListener('change', openOnMiddle);
    mark();
  })();
</script>
 
