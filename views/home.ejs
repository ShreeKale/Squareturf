<%- include('partials/head', { title, fullWidth: true }) %>
 
<%
  /* ---------- Sample slots shown in the hero card (hourly ranges) ---------- */
  const previewSlots = [
    ['6pm–7pm', 'open'], ['7pm–8pm', 'booked'], ['8pm–9pm', 'selected'], ['9pm–10pm', 'open'],
    ['10pm–11pm', 'open'], ['11pm–12am', 'booked'], ['12am–1am', 'open'], ['1am–2am', 'booked']
  ];
  const slotStyles = {
    open: 'bg-white text-neutral-900 ring-1 ring-inset ring-neutral-300',
    booked: 'bg-neutral-100 text-neutral-400 line-through',
    selected: 'bg-blue-600 text-white ring-1 ring-inset ring-blue-600 shadow-md'
  };
 
  /* ---------- Highlights (facts about the product, not made-up customer numbers) ---------- */
  const highlights = [
    ['24/7', 'Online booking', 'Players book any hour, even when you are asleep'],
    ['7 days', 'Free trial', 'No card needed to start'],
    ['6 steps', 'To go live', 'A guided set-up, no technical skills'],
    ['₹499', 'Starting per month', 'Basic plan, billed monthly']
  ];
 
  /* ---------- What you get ---------- */
  const features = [
    ['globe', 'Your own booking website', 'A branded page with your logo, photos, colours, pricing, facilities and map location. Share one link everywhere.'],
    ['calendar-days', 'Live slot availability', 'Players see which hours are free and which are taken, and request the slots they want. No back-and-forth calls.'],
    ['layout-dashboard', 'Simple owner dashboard', 'Confirm or cancel bookings, add walk-in and phone bookings, and update prices and timings from one screen.'],
    ['trending-up', 'Know how your turf is doing', 'See bookings, revenue and busy hours so you can plan offers for the slots that stay empty.'],
    ['users', 'Customer accounts', 'Regular players log in with their phone number and book faster. They can see their booking history any time.'],
    ['star', 'Reviews that build trust', 'Players who have booked can rate your turf. Good reviews and a clear refund policy help new customers say yes.'],
    ['image', 'Photos and facilities', 'Show off your ground with a photo gallery and facility cards: parking, floodlights, washrooms and more.'],
    ['message-circle', 'WhatsApp, Instagram and Maps', 'Players can message you, follow you and get directions in one tap from your website.'],
    ['smartphone', 'Made for phones', 'Most players book from their phone. Every page is built to look and work well on a small screen.']
  ];
 
  /* ---------- Before and after ---------- */
  const before = [
    'Bookings by phone calls and WhatsApp messages',
    'Slots written in a notebook, double bookings happen',
    'Players ask "is 8 PM free?" again and again',
    'No record of who played and how much you earned',
    'Hard to look professional online'
  ];
  const after = [
    'Players book themselves, any time of day',
    'One live calendar, a taken slot cannot be booked twice',
    'Free and taken hours are always visible',
    'Every booking and rupee tracked in your dashboard',
    'A clean website you can be proud to share'
  ];
 
  /* ---------- Less to manage ---------- */
  const managed = [
    ['server', 'Infrastructure', 'Reduce the need to arrange and manage separate hosting infrastructure.'],
    ['globe', 'Website & Domain', 'Get a dedicated turf website with a SquareTurf subdomain.'],
    ['database', 'Database Management', 'Keep website and booking data managed through the shared platform.'],
    ['wrench', 'Maintenance & Updates', 'Simplify ongoing technical management without building a system from scratch.']
  ];
 
  /* ---------- How it works ---------- */
  const steps = [
    ['Create your account', 'Sign up with your email and verify it with a 6-digit code.'],
    ['Tell us about your turf', 'Add your name, address, number of grounds, hourly price, opening hours and open days.'],
    ['Build your website', 'Upload your logo and photos, write a short description and pick a colour theme.'],
    ['Preview and publish', 'Check how it looks on phone and computer, then go live and share your link.']
  ];
 
  /* ---------- Plans (same as the pricing page) ---------- */
  const plans = [
    { name: 'Basic', price: '499', desc: 'For a professional online presence', features: ['Ready-made mobile website', 'SquareTurf address', '1 ground / pitch', '10 gallery photos', 'Manual bookings', 'Basic dashboard', 'Email support'] },
    { name: 'Standard', price: '999', desc: 'For growing turf businesses', features: ['Everything in Basic', 'Live slot availability', 'Online booking', 'Payment integration', 'Offers and reports'] },
    { name: 'Premium', price: '1,999', desc: 'For established businesses', features: ['Everything in Standard', 'Multiple grounds', 'Staff accounts', 'Advanced analytics', 'Priority support'] }
  ];
 
  /* ---------- Questions owners ask ---------- */
  const faqs = [
    ['Do I need any technical skills?', 'No. The set-up is a guided form: your turf details, your hours and prices, then your logo and photos. You can change everything later from your dashboard.'],
    ['How do players pay?', 'Players send a booking request for the hours they want and you confirm it. You can collect payment the way you do today, at the turf or by UPI. Online payment is being added, and we will tell you when it is ready.'],
    ['Can I add bookings myself?', 'Yes. Walk-in and phone bookings can be added from your dashboard in a few taps, so your calendar always shows the real picture.'],
    ['What do I need to start?', 'Your email address, your turf name and address, and a few photos. There is no card required for the 7-day free trial, and the trial starts only when you publish.'],
    ['I have more than one ground. Can I use SquareTurf?', 'Yes. Tell us how many grounds you have during set-up, and we will show you the plan that fits.'],
    ['Will it work on my players\' phones?', 'Yes. The website is designed phone-first, and it works just as well on a tablet or computer.']
  ];
%>
 
<style>
  /* Mown-grass stripes, drawn in CSS so no image file is needed */
  .turf-bg {
    background:
      radial-gradient(ellipse at 70% 50%, rgba(255,255,255,.14), transparent 60%),
      radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,.25) 100%),
      repeating-linear-gradient(90deg, #2e8b4a 0 80px, #3aa25b 80px 160px);
  }
  @keyframes st-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .st-rise { animation: st-rise .6s ease-out both; }
  @media (prefers-reduced-motion: reduce) { .st-rise { animation: none; } }
 
  /* Date strip in the website demo scrolls sideways without a visible bar */
  .demo-scroll { scrollbar-width: none; -ms-overflow-style: none; }
  .demo-scroll::-webkit-scrollbar { display: none; }
 
  /* Pricing on phones: swipe sideways, one plan in the middle with its neighbours peeking in.
     Change --plan-w to make the cards wider or narrower. */
  :root { --plan-w: min(70vw, 17.5rem); }
  @media (max-width: 639px) {
    .plan-scroller {
      position: relative;
      display: flex;
      gap: .75rem;
      margin-inline: -1rem;
      padding: 1rem calc((100vw - var(--plan-w)) / 2) 1.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .plan-scroller::-webkit-scrollbar { display: none; }
    .plan-scroller > [data-plan] { flex: 0 0 var(--plan-w); scroll-snap-align: center; }
  }
</style>
 
<!-- ================= Hero ================= -->
<section class="relative overflow-hidden border-b border-neutral-200">
  <div class="turf-bg absolute inset-0" aria-hidden="true"></div>
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice"
       fill="none" stroke="rgba(255,255,255,.55)" stroke-width="3" aria-hidden="true">
    <rect x="40" y="40" width="720" height="420"/>
    <line x1="400" y1="40" x2="400" y2="460"/>
    <circle cx="400" cy="250" r="62"/>
    <circle cx="400" cy="250" r="4" fill="rgba(255,255,255,.55)"/>
    <rect x="40" y="150" width="110" height="200"/>
    <rect x="40" y="200" width="45" height="100"/>
    <rect x="650" y="150" width="110" height="200"/>
    <rect x="715" y="200" width="45" height="100"/>
  </svg>
  <!-- Dark-green shade behind the text so it stays readable -->
  <div class="absolute inset-0 bg-gradient-to-r from-emerald-950/100 via-emerald-950/45 to-transparent" aria-hidden="true"></div>
 
  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-12 sm:px-6 md:py-16 lg:grid-cols-12 lg:px-8">
 
    <div class="st-rise lg:col-span-6">
      <p class="inline-flex items-center rounded-full bg-white/15 px-3.5 py-1.5 text-sm font-semibold text-white ring-1 ring-inset ring-white/30 backdrop-blur">
        Made for turf and ground owners
      </p>
      <h1 class="mt-5 text-4xl font-extrabold leading-[1.05] tracking-tight text-white drop-shadow-sm sm:text-5xl lg:text-6xl">
        Your turf, booked online around the clock.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-emerald-50">
        Launch a branded website for your turf, let players book open slots themselves, and manage prices, bookings and schedules from one dashboard.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/register" class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3.5 text-base font-semibold text-neutral-900 transition-colors hover:bg-neutral-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          Create your turf website
        </a>
        <a href="#demo" class="inline-flex items-center justify-center rounded-lg bg-white/10 px-6 py-3.5 text-base font-semibold text-white ring-1 ring-inset ring-white/70 transition-colors hover:bg-white/20">
          See a sample website
        </a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white">
        <li class="flex items-center gap-1.5"><i data-lucide="check" class="h-4 w-4"></i>7-day free trial</li>
        <li class="flex items-center gap-1.5"><i data-lucide="check" class="h-4 w-4"></i>No credit card needed</li>
        <li class="flex items-center gap-1.5"><i data-lucide="check" class="h-4 w-4"></i>Set up in minutes</li>
      </ul>
    </div>
 
    <!-- Booking preview -->
    <div class="st-rise lg:col-span-6" style="animation-delay:.15s">
      <div class="overflow-hidden rounded-2xl bg-white text-neutral-900 shadow-2xl shadow-black/30 ring-1 ring-neutral-200">
        <div class="flex items-center gap-1.5 border-b border-neutral-200 bg-neutral-100 px-4 py-3">
          <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-neutral-300"></span>
          <span class="ml-3 flex-1 truncate rounded-md bg-white px-3 py-1 text-xs text-neutral-500">greenfield-arena.squareturf.com</span>
        </div>
        <div class="p-5 sm:p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-lg font-bold leading-tight">Greenfield Arena</p>
              <p class="mt-0.5 text-sm text-neutral-500">5-a-side turf · Saturday</p>
            </div>
            <span class="shrink-0 rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">₹1,200 / hour</span>
          </div>
 
          <div class="mt-5 grid grid-cols-3 gap-2.5 sm:grid-cols-4" role="list" aria-label="Sample time slots">
            <% previewSlots.forEach(([time, state]) => { %>
              <div role="listitem" class="rounded-lg px-1.5 py-2.5 text-center text-[13px] font-medium sm:px-2 sm:text-sm <%= slotStyles[state] %>"><%= time %></div>
            <% }) %>
          </div>
 
          <div class="mt-5 flex items-center justify-between rounded-xl bg-neutral-50 px-4 py-3 ring-1 ring-inset ring-neutral-200">
            <p class="text-sm text-neutral-600"><span class="font-semibold text-neutral-900">8pm–9pm</span> selected</p>
            <span class="rounded-lg bg-neutral-900 px-4 py-2 text-sm font-semibold text-white">Confirm booking</span>
          </div>
        </div>
      </div>
      <p class="mt-3 text-center text-xs text-white drop-shadow">Preview of the booking page your customers will see.</p>
    </div>
  </div>
</section>
 
<!-- ================= Highlights ================= -->
<section aria-label="Highlights" class="border-b border-neutral-200 bg-white">
  <dl class="mx-auto grid max-w-7xl grid-cols-2 gap-y-6 px-4 py-8 sm:px-6 md:grid-cols-4 lg:px-8">
    <% highlights.forEach(([value, label, note], i) => { %>
      <div class="px-2 text-center md:px-6 <%= i > 0 ? 'md:border-l md:border-neutral-200' : '' %>">
        <dt class="sr-only"><%= label %></dt>
        <dd>
          <span class="block text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl"><%= value %></span>
          <span class="mt-1 block text-sm font-semibold text-blue-700"><%= label %></span>
          <span class="mx-auto mt-1 block max-w-[14rem] text-xs leading-snug text-neutral-500"><%= note %></span>
        </dd>
      </div>
    <% }) %>
  </dl>
</section>
 
<!-- ================= Features and benefits ================= -->
<section id="features" class="mx-auto max-w-7xl scroll-mt-16 px-4 py-10 sm:px-6 sm:py-12 md:py-16 lg:px-8">
  <div class="max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">What you get</p>
    <h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Everything a turf owner needs to take bookings</h2>
    <p class="mt-4 text-lg leading-relaxed text-neutral-600">Stop managing slots over phone calls and notebooks. SquareTurf keeps your website, calendar and customers in one place.</p>
  </div>
 
  <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 sm:mt-10 sm:gap-x-8 sm:gap-y-10 lg:grid-cols-3 lg:gap-x-10">
    <% features.forEach(([icon, heading, text]) => { %>
      <article class="min-w-0 border-t-2 border-neutral-300 pt-4 sm:pt-6">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-600 sm:h-11 sm:w-11">
          <i data-lucide="<%= icon %>" class="h-4 w-4 sm:h-5 sm:w-5"></i>
        </div>
        <h3 class="mt-3 text-[15px] font-bold leading-snug tracking-tight sm:mt-5 sm:text-xl"><%= heading %></h3>
        <p class="mt-1.5 text-[13px] leading-relaxed text-neutral-600 sm:mt-2 sm:text-base"><%= text %></p>
      </article>
    <% }) %>
  </div>
 
  <!-- Before and after -->
  <div class="mt-10 grid gap-4 sm:mt-14 md:grid-cols-2 md:gap-6">
    <div class="rounded-2xl bg-white p-6 ring-1 ring-neutral-200 sm:p-8">
      <h3 class="text-lg font-bold text-neutral-900">Running a turf without SquareTurf</h3>
      <ul class="mt-5 space-y-3.5">
        <% before.forEach((line) => { %>
          <li class="flex items-start gap-3 text-neutral-600">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600"><i data-lucide="x" class="h-3.5 w-3.5"></i></span>
            <span><%= line %></span>
          </li>
        <% }) %>
      </ul>
    </div>
    <div class="rounded-2xl bg-emerald-950 p-6 text-white sm:p-8">
      <h3 class="text-lg font-bold">Running a turf with SquareTurf</h3>
      <ul class="mt-5 space-y-3.5">
        <% after.forEach((line) => { %>
          <li class="flex items-start gap-3 text-emerald-50">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/30 text-emerald-200"><i data-lucide="check" class="h-3.5 w-3.5"></i></span>
            <span><%= line %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>
 
<!-- ================= Website demo ================= -->
