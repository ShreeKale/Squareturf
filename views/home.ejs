          <% [
            ['calendar-days', 'A date picker and live slots', 'Next 20 days, with closed days greyed out.'],
            ['image', 'Gallery and facility cards', 'Your photos, parking, floodlights and more.'],
            ['star', 'Customer reviews', 'Ratings from players who have booked.'],
